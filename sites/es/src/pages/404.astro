---
import Layout from "../components/Layout.astro";
---
<Layout title="Página no encontrada | Baitaan" description="La página que buscas no existe.">
  <div class="py-10 text-center">
    <p class="text-6xl font-bold text-teal-800">404</p>
    <h1 class="mt-4 text-2xl font-bold">Esta página no existe</h1>
    <p class="mt-3 text-stone-600">Puede que la dirección esté mal escrita o que la página se haya movido.</p>
    <a href="/" class="mt-6 inline-block rounded-lg bg-teal-700 px-5 py-2.5 font-semibold text-white hover:bg-teal-800">Ver todas las herramientas</a>
  </div>
</Layout>
