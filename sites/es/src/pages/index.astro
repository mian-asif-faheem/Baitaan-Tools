---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../components/Layout.astro";
import HomeExtras from "../components/HomeExtras.astro";
import PhoneShot from "@bt/ui/sections/PhoneShot.astro";

const groups: Group[] = [
  {
    title: "Calculadoras laborales · México",
    featured: {
      href: "/calculadora-finiquito/",
      name: "Finiquito y liquidación",
      desc: "Renuncia o despido, según la Ley Federal del Trabajo",
      exampleLabel: "Ejemplo · despido, $12,000 al mes",
      example: "$66,596.72"
    },
    tools: [
      {
        href: "/calculadora-sueldo-neto/",
        name: "Sueldo neto 2026",
        desc: "ISR, subsidio para el empleo e IMSS"
      },
      {
        href: "/calculadora-aguinaldo/",
        name: "Aguinaldo",
        desc: "Cuánto te toca según los días trabajados"
      },
      {
        href: "/calculadora-vacaciones/",
        name: "Vacaciones y prima vacacional",
        desc: "Días por antigüedad y pago de la prima"
      }
    ]
  },
  {
    title: "Documentos",
    tools: [
      {
        href: "/foto-tamano-infantil/",
        name: "Foto tamaño infantil",
        desc: "Infantil, pasaporte, credencial, título y DNI"
      },
      {
        href: "/comprimir-pdf/",
        name: "Comprimir PDF a 1 MB",
        desc: "Para portales que limitan el tamaño"
      }
    ]
  }
];
---
<Layout bleed wide title="Herramientas gratis en español | Baitaan" description="Calculadoras laborales y herramientas gratuitas que funcionan en tu navegador, sin registro: finiquito, sueldo neto, aguinaldo, fotos tamaño infantil y comprimir PDF.">
  <Hero title="Herramientas gratis, sin registro" lead="Calculadoras laborales y utilidades que funcionan en tu navegador. Tus datos nunca salen de tu dispositivo." cta={{ href: "/calculadora-finiquito/", label: "Calcular mi finiquito" }}>
    <PhoneShot slot="visual" title="Calculadora de finiquito" label="Total estimado · renuncia" value="$7,438.36" rows={[["Aguinaldo", "$3,719.18"], ["Vacaciones", "$2,975.34"], ["Prima vacacional", "$743.84"]]} />
  </Hero>
  <HomeExtras lang="es" part="top" />
  <ToolGrid {groups} />
  <HomeExtras lang="es" part="bottom" />
</Layout>
