---
import Layout from "../components/Layout.astro";

const groups = [
  {
    title: "Calculadoras laborales · México",
    tools: [
      { href: "/calculadora-finiquito/", name: "Finiquito y liquidación", desc: "Renuncia o despido, según la Ley Federal del Trabajo" },
      { href: "/calculadora-sueldo-neto/", name: "Sueldo neto 2026", desc: "ISR, subsidio para el empleo e IMSS" },
      { href: "/calculadora-aguinaldo/", name: "Aguinaldo", desc: "Cuánto te toca según los días trabajados" },
      { href: "/calculadora-vacaciones/", name: "Vacaciones y prima vacacional", desc: "Días por antigüedad y pago de la prima" },
    ],
  },
  {
    title: "Documentos",
    tools: [
      { href: "/foto-tamano-infantil/", name: "Foto tamaño infantil", desc: "Infantil, pasaporte, credencial, título y DNI" },
      { href: "/comprimir-pdf/", name: "Comprimir PDF a 1 MB", desc: "Para portales que limitan el tamaño" },
    ],
  },
  {
    title: "Próximamente",
    soon: true,
    tools: [
      { href: "#", name: "Nómina y sueldo neto · España", desc: "IRPF y Seguridad Social" },
      { href: "#", name: "Liquidación, prima y cesantías · Colombia", desc: "" },
      { href: "#", name: "Finiquito y sueldo líquido · Chile", desc: "" },
      { href: "#", name: "CTS y gratificación · Perú", desc: "" },
    ],
  },
];
---
<Layout title="Herramientas gratis en español | Baitaan" description="Calculadoras laborales y herramientas gratuitas que funcionan en tu navegador, sin registro: finiquito, sueldo neto, aguinaldo, fotos tamaño infantil y comprimir PDF.">
  <h1 class="text-3xl font-bold tracking-tight">Herramientas gratis, sin registro</h1>
  <p class="mt-3 text-lg text-stone-600">Calculadoras laborales y utilidades que funcionan en tu navegador. Tus datos nunca salen de tu dispositivo.</p>
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class={`block h-full rounded-xl border bg-white p-5 shadow-sm ${g.soon ? "pointer-events-none border-dashed border-stone-300 opacity-60" : "border-stone-200 hover:border-teal-700"}`}
            >
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
