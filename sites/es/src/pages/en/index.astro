---
import Hero from "@bt/ui/Hero.astro";
import Layout from "../../components/Layout.astro";

const groups = [
  {
    title: "Labor calculators · Mexico",
    tools: [
      { href: "/en/calculadora-finiquito/", name: "Finiquito and severance", desc: "Resignation or dismissal, under the Federal Labor Law" },
      { href: "/en/calculadora-sueldo-neto/", name: "Net pay 2026", desc: "ISR, employment subsidy and IMSS" },
      { href: "/en/calculadora-aguinaldo/", name: "Aguinaldo (Christmas bonus)", desc: "How much you get for the days you worked" },
      { href: "/en/calculadora-vacaciones/", name: "Vacation days and premium", desc: "Days by years of service, plus the premium" },
    ],
  },
  {
    title: "Documents",
    tools: [
      { href: "/en/foto-tamano-infantil/", name: "ID photo sizes", desc: "Infantil, passport, credential, diploma and Spanish DNI" },
      { href: "/en/comprimir-pdf/", name: "Compress PDF to 1 MB", desc: "For portals with an upload limit" },
    ],
  },
  {
    title: "Coming soon",
    soon: true,
    tools: [
      { href: "#", name: "Payroll and net pay · Spain", desc: "IRPF and Social Security" },
      { href: "#", name: "Severance, bonus and cesantías · Colombia", desc: "" },
      { href: "#", name: "Finiquito and net pay · Chile", desc: "" },
      { href: "#", name: "CTS and gratificación · Peru", desc: "" },
    ],
  },
];
---
<Layout lang="en" title="Free tools for Mexico, in English | Baitaan" description="Free Mexican labor calculators and everyday tools that run in your browser, with no sign-up: finiquito, net pay, aguinaldo, ID photos and PDF compression.">
  <Hero title="Free tools, no sign-up" lead="Mexican labor calculators and everyday tools that run in your browser. Your data never leaves your device." />
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class={`block h-full rounded-xl border bg-white p-5 shadow-sm ${g.soon ? "pointer-events-none border-dashed border-stone-300 opacity-60" : "relative isolate overflow-hidden border-stone-200 hover:border-teal-700"}`}
              data-spotlight={g.soon ? undefined : ""}
            >
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  import { spotlightAll } from "@bt/ui/fx/spotlight";
  spotlightAll();
</script>
