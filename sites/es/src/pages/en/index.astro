---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../../components/Layout.astro";

const groups: Group[] = [
  {
    title: "Labor calculators · Mexico",
    featured: {
      href: "/en/calculadora-finiquito/",
      name: "Finiquito and severance",
      desc: "Resignation or dismissal, under the Federal Labor Law",
      exampleLabel: "Example · dismissal, $12,000 a month",
      example: "$66,596.72"
    },
    tools: [
      {
        href: "/en/calculadora-sueldo-neto/",
        name: "Net pay 2026",
        desc: "ISR, employment subsidy and IMSS"
      },
      {
        href: "/en/calculadora-aguinaldo/",
        name: "Aguinaldo (Christmas bonus)",
        desc: "How much you get for the days you worked"
      },
      {
        href: "/en/calculadora-vacaciones/",
        name: "Vacation days and premium",
        desc: "Days by years of service, plus the premium"
      }
    ]
  },
  {
    title: "Documents",
    tools: [
      {
        href: "/en/foto-tamano-infantil/",
        name: "ID photo sizes",
        desc: "Infantil, passport, credential, diploma and Spanish DNI"
      },
      {
        href: "/en/comprimir-pdf/",
        name: "Compress PDF to 1 MB",
        desc: "For portals with an upload limit"
      }
    ]
  },
  {
    title: "Coming soon",
    soon: true,
    tools: [
      {
        href: "#",
        name: "Payroll and net pay · Spain",
        desc: "IRPF and Social Security"
      },
      {
        href: "#",
        name: "Severance, bonus and cesantías · Colombia"
      },
      {
        href: "#",
        name: "Finiquito and net pay · Chile"
      },
      {
        href: "#",
        name: "CTS and gratificación · Peru"
      }
    ]
  }
];
---
<Layout bleed wide lang="en" title="Free tools for Mexico, in English | Baitaan" description="Free Mexican labor calculators and everyday tools that run in your browser, with no sign-up: finiquito, net pay, aguinaldo, ID photos and PDF compression.">
  <Hero title="Free tools, no sign-up" lead="Mexican labor calculators and everyday tools that run in your browser. Your data never leaves your device." cta={{ href: "/en/calculadora-finiquito/", label: "Calculate my finiquito" }} />
  <ToolGrid {groups} />
</Layout>
