---
import BaseLayout from "@bt/ui/BaseLayout.astro";
import plex from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import { NATIVE, getT, versionsFor, type Lang } from "../i18n";
import "../global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 404 pages: no language redirect, switcher points to the other home page. */
  notFound?: boolean;
  /** Page lays out its own full-width sections (tool and home pages). */
  bleed?: boolean;
  /** Wide footer for home pages. */
  wide?: boolean;
}
const { title, description, lang = NATIVE, notFound = false, bleed = false, wide = false } = Astro.props;
const t = getT(lang);
const versions = versionsFor(notFound ? (lang === "en" ? "/en/" : "/") : Astro.url.pathname);
---
<BaseLayout
  site="es" preload={[plex]}
  wordmark
  {title}
  {description}
  code={lang}
  lang={lang}
  dir="ltr"
  {versions}
  nav={t.nav}
  footer={t.footer}
  footerNote={t.footerNote}
  brand={t.brand}
  homeHref={lang === "en" ? "/en/" : "/"}
  chrome={t.chrome}
  langRedirect={!notFound}
  {bleed}
  {wide}
>
  <slot />
</BaseLayout>
