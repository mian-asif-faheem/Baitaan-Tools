  /*
   * Hover test 1, language cards: four soft circles in the site's own colours, blurred at rest,
   * that sharpen and drift apart on hover. They sit behind the text (the card isolates its
   * stacking) and mirror for the Arabic card.
   */
  .bt-blobs {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    --x: 1;
  }
  .bt-lang-card[dir="rtl"] .bt-blobs {
    --x: -1;
  }
  .bt-blobs b {
    position: absolute;
    border-radius: 999px;
    opacity: 0.2;
    filter: blur(8px);
    transition: transform 500ms var(--ease), filter 500ms var(--ease), opacity 500ms var(--ease);
  }
  .bt-blobs b:nth-child(1) { width: 220px; height: 220px; inset-inline-end: 4px; bottom: -130px; background: var(--d2-l); }
  .bt-blobs b:nth-child(2) { width: 48px; height: 48px; inset-inline-end: 56px; bottom: 56px; background: var(--b-l); }
  .bt-blobs b:nth-child(3) { width: 130px; height: 130px; inset-inline-end: 4px; top: -70px; background: var(--d3-l); }
  .bt-blobs b:nth-child(4) { width: 84px; height: 84px; inset-inline-start: 40%; bottom: -44px; background: var(--d1-l); }
  .bt-lang-card:hover .bt-blobs b,
  .bt-lang-card:focus-visible .bt-blobs b {
    filter: blur(0);
    opacity: 0.28;
  }
  .bt-lang-card:hover .bt-blobs b:nth-child(1),
  .bt-lang-card:focus-visible .bt-blobs b:nth-child(1) { transform: translate(calc(48px * var(--x)), 48px); }
  .bt-lang-card:hover .bt-blobs b:nth-child(2),
  .bt-lang-card:focus-visible .bt-blobs b:nth-child(2) { transform: translate(calc(48px * var(--x)), 8px); }
  .bt-lang-card:hover .bt-blobs b:nth-child(3),
  .bt-lang-card:focus-visible .bt-blobs b:nth-child(3) { transform: translate(calc(48px * var(--x)), -48px); }
  .bt-lang-card:hover .bt-blobs b:nth-child(4),
  .bt-lang-card:focus-visible .bt-blobs b:nth-child(4) { transform: translateX(calc(-48px * var(--x))); }
  :global(html.dark) .bt-blobs b { opacity: 0.3; }
  :global(html.dark) .bt-lang-card:hover .bt-blobs b { opacity: 0.42; }
  :global(html.dark) .bt-blobs b:nth-child(1) { background: var(--d2-d); }
  :global(html.dark) .bt-blobs b:nth-child(2) { background: var(--b-d); }
  :global(html.dark) .bt-blobs b:nth-child(3) { background: var(--d3-d); }
  :global(html.dark) .bt-blobs b:nth-child(4) { background: var(--d1-d); }

  @media (prefers-reduced-motion: reduce) {
    .bt-blobs b {
      transition: none;
    }
    .bt-lang-card:hover .bt-blobs b {
      transform: none !important;
    }
  }

  /*
   * Movie blocks (country cards): at rest the photo sits under frosted glass with its name on it and a thin bar in
   * the site's colour at the bottom. On hover or keyboard focus the dark layer slides up, a strip
   * drops in from the top, the coloured bar grows with the title, a big label rises and the photo
   * moves up a little. Based on "Movie Blocks" by Elegant Division.
   */
  .bt-mb {
    --t: 0.5s;
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    font-size: 16px;
    color: #fff;
    background: #2b2b2b;
    /* The site's colour, toned down so it doesn't glare once the bar opens. */
    --mb-dim: color-mix(in srgb, var(--mb) 72%, #111);
  }
  .bt-mb > span {
    position: absolute;
    inset-inline: 0;
  }
  .bt-mb__top,
  .bt-mb__main-in,
  .bt-mb__rise,
  .bt-mb__bar-in {
    padding-inline: 14px;
  }
  .bt-mb__cover {
    display: block;
    width: 100%;
    height: calc(100% + 1.25em);
    object-fit: cover;
    transition: transform var(--t) ease-out;
  }
  .bt-mb__top {
    z-index: 4;
    top: -2.25em;
    height: 2.25em;
    padding-top: 2.25em;
    overflow: hidden;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.5);
    transition: top calc(var(--t) / 2) cubic-bezier(0.22, 0.61, 0.36, 1),
      padding calc(var(--t) / 2) cubic-bezier(0.22, 0.61, 0.36, 1) calc(var(--t) / 2);
  }
  .bt-mb__main {
    z-index: 3;
    top: 0;
    bottom: -0.875em;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(20, 20, 24, 0.30));
    -webkit-backdrop-filter: blur(3px) saturate(1.1);
    backdrop-filter: blur(3px) saturate(1.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    border-bottom: 2.125em solid var(--mb-dim);
    transition: bottom calc(var(--t) / 1.2) cubic-bezier(0.17, 0.84, 0.44, 1) calc(var(--t) / 6),
      border-bottom calc(var(--t) / 1.5) cubic-bezier(0.39, 0.58, 0.57, 1) calc(var(--t) / 3);
  }
  .bt-mb__main-in {
    position: absolute;
    inset-inline: 0;
    bottom: 0.875em;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: bottom var(--t) ease-out;
  }
  .bt-mb__big,
  .bt-mb__sub {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }
  .bt-mb__big {
    font-size: 1.75em;
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .bt-mb__sub {
    font-size: 14px;
    opacity: 0.85;
  }
  .bt-mb__rise {
    z-index: 2;
    bottom: -0.536em;
    font-size: 2.4em;
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
    transition: bottom calc(var(--t) / 3) ease-out;
  }
  .bt-mb__bar {
    z-index: 4;
    bottom: 0;
    height: 1.25em;
    overflow: hidden;
    border-top: 0 solid rgba(255, 255, 255, 0.7);
    /* Glass in the site's colour: see-through tint, blurred photo behind, a light top edge. */
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0)),
      color-mix(in srgb, var(--mb-dim) 62%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: height var(--t) cubic-bezier(0.17, 0.84, 0.44, 1);
  }
  .bt-mb__bar-in {
    position: absolute;
    inset-inline: 0;
    bottom: 2em;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 2em;
    gap: 2px;
    transition: bottom var(--t) ease-out calc(var(--t) / 6);
  }
  /* The country name is already on the card; in the bar it stays only for screen readers. */
  .bt-mb__t {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bt-mb__s {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }
  a:hover > .bt-mb .bt-mb__top,
  a:focus-visible > .bt-mb .bt-mb__top {
