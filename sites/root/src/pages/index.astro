---
import Hero from "@bt/ui/Hero.astro";
import Icon from "@bt/ui/Icon.astro";
import { arrowLeft, arrowRight, arrowUpRight, bookOpen, calendarBlank, checkCircle, lockSimple } from "@bt/ui/icons";
import { SITES } from "@bt/ui/sites";
import Layout from "../components/Layout.astro";
import { nextHijriOccurrence } from "@bt/tools/hijri-dates";
import Stats from "@bt/ui/sections/Stats.astro";
import HowItWorks from "@bt/ui/sections/HowItWorks.astro";
import Section from "@bt/ui/sections/Section.astro";
import Situations from "@bt/ui/sections/Situations.astro";
import Examples from "@bt/ui/sections/Examples.astro";

/**
 * Each card carries a hint of its own site's palette: three swatch dots and the arrow button,
 * in both light and dark.
 */
const card = (tones: string[], primaryL: string, primaryD: string, cardD: string) =>
  [
    `--d1-l:${tones[1]}`, `--d2-l:${tones[2]}`, `--d3-l:${tones[3]}`,
    `--d1-d:${tones[2]}`, `--d2-d:${tones[3]}`, `--d3-d:${primaryD}`,
    `--b-l:${primaryL}`, `--b-d:${primaryD}`, `--o-l:#fff`, `--o-d:${cardD}`,
  ].join(";");

const langs = [
  {
    site: SITES.es, name: "Español", go: "Abrir herramientas",
    desc: "Calculadoras laborales para México: finiquito, aguinaldo, sueldo neto y más.",
    style: card(["#0E0B1D", "#2A1E4D", "#5A3B8C", "#8B7CC7"], "#5A3B8C", "#AA9CE2", "#17132B"),
  },
  {
    site: SITES.pt, name: "Português", go: "Abrir ferramentas",
    desc: "Calculadoras trabalhistas do Brasil: rescisão, férias, 13º salário e mais.",
    style: card(["#0B1526", "#1B2F52", "#2F5597", "#6F8FC7"], "#2F5597", "#94B2E6", "#111D33"),
  },
  {
    site: SITES.ar, name: "العربية", go: "افتح الأدوات",
    desc: "التاريخ الهجري، ومكافأة نهاية الخدمة، والزكاة لدول الخليج.",
    style: card(["#0F1F17", "#1E3A2E", "#3E5A3F", "#6B7F67"], "#3E5A3F", "#A8C29F", "#14271E"),
  },
];

/** Real screenshots of each tool's answer (sites/root/public/img/tools, 960×600 WebP). */
const popular = [
  { img: "finiquito", site: SITES.es, path: "/calculadora-finiquito/", tag: "Español · México", title: "Finiquito y liquidación",
    desc: "What you are owed when you resign or are dismissed in Mexico, under the Ley Federal del Trabajo.",
    alt: "Finiquito calculator answer: estimated total of $13,582.19 with its breakdown" },
  { img: "sueldo-neto", site: SITES.es, path: "/calculadora-sueldo-neto/", tag: "Español · México", title: "Sueldo neto",
    desc: "Take-home pay in Mexico after ISR and IMSS, with the 2026 tax table and employment subsidy.",
    alt: "Net salary calculator answer: $13,203.20 a month" },
  { img: "rescisao", site: SITES.pt, path: "/calculadora-rescisao/", tag: "Português · Brasil", title: "Rescisão trabalhista",
    desc: "Brazilian severance for each type of dismissal under the CLT, including the 40% FGTS fine.",
    alt: "Severance calculator answer: R$ 10.887,23 to receive" },
  { img: "salario-liquido", site: SITES.pt, path: "/calculadora-salario-liquido/", tag: "Português · Brasil", title: "Salário líquido",
    desc: "Net salary in Brazil after INSS and income tax, with the 2026 tables and the new tax reduction.",
    alt: "Net salary calculator answer: R$ 4.498,49" },
  { img: "hijri", site: SITES.ar, path: "/tahweel-altareekh/", tag: "العربية · الخليج", title: "Hijri date converter",
    desc: "Convert between Hijri (Umm al-Qura) and Gregorian dates in either direction.",
    alt: "Date converter answer showing a Hijri date" },
  { img: "end-of-service", site: SITES.ar, path: "/nihayat-alkhidma-saudi/", tag: "العربية · السعودية", title: "End-of-service benefit",
    desc: "The Saudi end-of-service award under the Labour Law, articles 84 to 87, for resignation or termination.",
    alt: "End-of-service calculator answer in Saudi riyals with its breakdown" },
  { img: "13-salario", site: SITES.pt, path: "/calculadora-13-salario/", tag: "Português · Brasil", title: "13º salário",
    desc: "Both instalments of Brazil’s 13th salary, with INSS and income tax on the second one.",
    alt: "13th salary calculator answer: R$ 2.751,40 net, with the 1st instalment of R$ 1.500,00" },
  { img: "ramadan", site: SITES.ar, path: "/kam-baqi-ala-ramadan/", tag: "العربية · الخليج", title: "Ramadan countdown",
    desc: "How long until Ramadan, Eid al-Fitr and Eid al-Adha, by the Umm al-Qura calendar.",
    alt: "Ramadan countdown answer: expected start Monday 8 February 2027, 1 Ramadan 1448" },
  { img: "zakat", site: SITES.ar, path: "/hasibat-azzakat/", tag: "العربية · الخليج", title: "Zakat calculator",
    desc: "Zakat on money and gold: the nisab (85 g of gold or 595 g of silver) and 2.5% of what you own.",
    alt: "Zakat calculator answer: 1,500 due on 60,000 of savings" },
];

/** "Find your tool": start from the situation, not the tool name. */
const situations = [
  { href: SITES.es.url + "/calculadora-finiquito/", title: "I was dismissed in Mexico. What am I owed?", sub: "Finiquito y liquidación", icon: "out" as const },
  { href: SITES.pt.url + "/calculadora-salario-liquido/", title: "What is my take-home pay in Brazil?", sub: "Salário líquido", icon: "money" as const },
  { href: SITES.ar.url + "/en/kam-baqi-ala-ramadan/", title: "When is Ramadan, and when is Eid?", sub: "Ramadan countdown", icon: "moon" as const },
  { href: SITES.ar.url + "/en/nihayat-alkhidma-saudi/", title: "How much is my Saudi end-of-service award?", sub: "End-of-service benefit (Saudi)", icon: "scale" as const },
  { href: SITES.es.url + "/en/comprimir-pdf/", title: "My PDF is too big for the portal.", sub: "Compress PDF to 1 MB", icon: "doc" as const },
  { href: SITES.ar.url + "/en/hasibat-azzakat/", title: "What is 2.5% zakat on my savings?", sub: "Zakat calculator", icon: "percent" as const },
];

/** Worked examples: each figure is pinned by a unit test in packages/tools/test. */
const examples = [
  { label: "Mexico · resigning after 6 months", total: "$7,438.36",
    rows: [["Salary", "$15,000 a month"], ["Days worked", "181"], ["Aguinaldo", "$3,719.18"], ["Holidays", "$2,975.34"], ["Holiday bonus", "$743.84"]] as [string, string][],
    href: SITES.es.url + "/en/calculadora-finiquito/", cta: "Calculate yours" },
  { label: "Brazil · dismissed without just cause", total: "R$ 13.392,64",
    rows: [["Salary", "R$ 3.000"], ["Worked", "1 Mar 2024 to 15 Aug 2026"], ["Plus 40% FGTS fine", "R$ 3.115,20"]] as [string, string][],
    href: SITES.pt.url + "/en/calculadora-rescisao/", cta: "Calculate yours" },
  { label: "Brazil · net salary", total: "R$ 4.498,49",
    rows: [["Gross", "R$ 5.000 a month"], ["INSS", "−R$ 501,51"], ["Income tax", "R$ 0,00 (none up to R$ 5.000 in 2026)"]] as [string, string][],
    href: SITES.pt.url + "/en/calculadora-salario-liquido/", cta: "Calculate yours" },
  { label: "Saudi Arabia · end of service after 7 years", total: "36,000 SAR",
    rows: [["Actual wage", "8,000 SAR a month"], ["First 5 years, half a month each", "20,000 SAR"], ["Next 2 years, a full month each", "16,000 SAR"]] as [string, string][],
    href: SITES.ar.url + "/en/nihayat-alkhidma-saudi/", cta: "Calculate yours" },
];

/** Every tool, by site. Paths are the native-language pages; each also has an /en/ version. */
const allTools = [
  { site: SITES.es, name: "Español · México", tools: [
    ["/calculadora-finiquito/", "Finiquito y liquidación", "What you are owed when you resign or are dismissed."],
    ["/calculadora-sueldo-neto/", "Sueldo neto", "Take-home pay after ISR and IMSS."],
    ["/calculadora-aguinaldo/", "Aguinaldo", "At least 15 days’ pay, or the proportional part."],
    ["/calculadora-vacaciones/", "Vacaciones y prima vacacional", "Holiday days under article 76 and the 25% bonus."],
    ["/foto-tamano-infantil/", "Foto tamaño infantil", "Passport, ID and child-size photos, ready to print."],
    ["/comprimir-pdf/", "Comprimir PDF", "Shrink a PDF to 1 MB or 2 MB, without uploading it."],
  ] },
  { site: SITES.pt, name: "Português · Brasil", tools: [
    ["/calculadora-rescisao/", "Rescisão trabalhista", "Severance for each type of dismissal, with the 40% FGTS fine."],
    ["/calculadora-salario-liquido/", "Salário líquido", "Net salary after INSS and income tax."],
    ["/calculadora-ferias/", "Férias", "Holiday pay with the 1/3 bonus, and selling up to 10 days."],
    ["/calculadora-13-salario/", "13º salário", "Both instalments, with INSS and income tax."],
    ["/calculadora-horas-extras/", "Horas extras e adicional noturno", "Overtime at 50% or 100%, night work and the DSR."],
    ["/calculadora-salario-proporcional/", "Salário proporcional", "Pay for part of a month, and absence deductions."],
    ["/foto-3x4/", "Foto 3x4", "3x4 photos on a 10x15 sheet, ready to print."],
    ["/comprimir-pdf/", "Comprimir PDF", "Shrink a PDF to 1 MB or 2 MB in your browser."],
    ["/juntar-pdf/", "Juntar PDF", "Join PDFs and photos into a single PDF."],
  ] },
  { site: SITES.ar, name: "العربية · الخليج", tools: [
    ["/tahweel-altareekh/", "Hijri date converter", "Hijri (Umm al-Qura) to Gregorian, either way."],
    ["/kam-baqi-ala-ramadan/", "Ramadan countdown", "How long until Ramadan."],
    ["/kam-baqi-ala-eid-alfitr/", "Eid al-Fitr countdown", "How long until 1 Shawwal."],
    ["/kam-baqi-ala-eid-aladha/", "Eid al-Adha countdown", "How long until 10 Dhul-Hijjah."],
    ["/hisab-alumr-bilhijri/", "Hijri age", "Your age in Hijri years."],
    ["/alfarq-bayna-tarikhayn/", "Date difference", "The time between two dates."],
    ["/nihayat-alkhidma-saudi/", "Saudi end-of-service benefit", "Labour Law articles 84, 85 and 87."],
    ["/nihayat-alkhidma-uae/", "UAE end-of-service benefit", "Federal Decree-Law No. 33 of 2021."],
    ["/hasibat-addariba/", "VAT calculator", "15% Saudi Arabia, 5% UAE and Oman, 10% Bahrain."],
    ["/hasibat-azzakat/", "Zakat calculator", "The nisab and 2.5% of what you own."],
    ["/maqas-assura/", "Photo size for printing", "Passport and ID photos sized for printing."],
    ["/dagt-pdf/", "Compress PDF", "Shrink a PDF to 1 MB, without uploading it."],
    ["/damj-pdf/", "Merge PDF", "Join PDFs and photos into one file."],
    ["/adad-alkalimat/", "Word counter", "Words and characters in Arabic or English."],
  ] },
];
const toolCount = allTools.reduce((n, g) => n + g.tools.length, 0);

const news = [
  { date: "Nov 2026", title: "A named reviewer on every calculator", text: "Each calculator says who checks it, and the About pages explain how." },
  { date: "Nov 2026", title: "Wording checked page by page", text: "The Spanish, Portuguese and Arabic sites were reviewed line by line; a few labels and examples were made clearer." },
  { date: "Nov 2026", title: "Longer guides where people search most", text: "Ramadan and Eid countdowns, the Hijri converter, VAT, zakat and the PDF tools now explain how they work, with FAQs." },
];

/**
 * "Coming up": the next payment deadlines and Ramadan, worked out at build time. Each item also
 * carries its end date, and a small script hides it once that day has passed (the page is static
 * between deploys); the strip disappears when nothing is left.
 */
const now = new Date();
const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
const dayMs = 86_400_000;
const ymd = (d: number) => new Date(d).toISOString().slice(0, 10);
const fmt = (d: number) => new Intl.DateTimeFormat("en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" }).format(d);
/** Next 30 Nov / 20 Dec (this year, or next once it has passed). */
const nextOn = (m: number, day: number) => {
  const d = Date.UTC(now.getUTCFullYear(), m - 1, day);
  return d >= today ? d : Date.UTC(now.getUTCFullYear() + 1, m - 1, day);
};
/** Brazil: when the deadline falls on a weekend, the 13th salary is paid on the Friday before. */
const workdayBefore = (d: number) => {
  const w = new Date(d).getUTCDay();
  return w === 0 ? d - 2 * dayMs : w === 6 ? d - dayMs : d;
};
const br1 = workdayBefore(nextOn(11, 30));
const br2 = workdayBefore(nextOn(12, 20));
const mx = nextOn(12, 20);
const ramadan = nextHijriOccurrence(9, 1).gregorian.getTime();
const comingUp = [
  { end: ymd(br1), when: br1, place: "Brazil", text: "13th salary, 1st instalment", href: SITES.pt.url + "/calculadora-13-salario/", by: `by ${fmt(br1)}` },
  { end: ymd(mx - dayMs), when: mx, place: "Mexico", text: "Aguinaldo", href: SITES.es.url + "/calculadora-aguinaldo/", by: `before ${fmt(mx)}` },
  { end: ymd(br2), when: br2, place: "Brazil", text: "13th salary, 2nd instalment", href: SITES.pt.url + "/calculadora-13-salario/", by: `by ${fmt(br2)}` },
  { end: ymd(ramadan), when: ramadan, place: "Gulf", text: "Ramadan starts", href: SITES.ar.url + "/en/kam-baqi-ala-ramadan/", by: `around ${fmt(ramadan)}` },
].filter((c) => c.when >= today).sort((a, b) => a.when - b.when).slice(0, 4);

// Tool counts: 6 on es., 9 on pt., 14 on ar. Update when a tool is added.
const stats = [
  { value: String(toolCount), label: "free tools" },
  { value: "3", label: "languages, each with English" },
  { value: "2026", label: "tax tables and minimum wages" },
  { value: "0", label: "numbers or files uploaded" },
];

const how = [
  { title: "Pick your country", text: "Each site follows its own country’s laws: Mexico, Brazil or the Gulf." },
  { title: "Enter your numbers", text: "Salary, dates or a file. Everything stays in your browser." },
  { title: "Read the breakdown", text: "Each result shows how it was worked out, and the page links to the law and tables it uses." },
];

/** Each site's main colour, for the coloured bar of its movie blocks (white text passes AA on all three). */
const tone = { es: "#5A3B8C", pt: "#2F5597", ar: "#3E5A3F" } as Record<string, string>;
const short = { es: "México", pt: "Brasil", ar: "الخليج" } as Record<string, string>;
const law = { es: "Ley Federal del Trabajo", pt: "CLT", ar: "نظام العمل" } as Record<string, string>;

const countries = [
  { photo: "mexico", alt: "Paseo de la Reforma in Mexico City, Mexico", site: SITES.es, name: "Mexico", count: "6 tools in Spanish",
    text: "Ley Federal del Trabajo, ISR and IMSS. The 2026 minimum wage of $315.04 a day and the UMA of $117.31." },
  { photo: "brazil", alt: "Avenida Paulista in São Paulo, Brazil", site: SITES.pt, name: "Brazil", count: "9 tools in Portuguese",
    text: "CLT, INSS and income tax. Since January 2026, pay up to R$ 5.000 a month has no income tax withheld." },
  { photo: "gulf", alt: "Riyadh skyline at sunset, Saudi Arabia", site: SITES.ar, name: "The Gulf", count: "14 tools in Arabic",
    text: "Saudi and UAE labour laws, VAT and zakat, and the Umm al-Qura Hijri calendar." },
];

const updates = [
  { date: "Feb 2026", title: "Mexico: UMA of $117.31", text: "The tax-free parts of finiquito, aguinaldo and prima vacacional were recalculated." },
  { date: "Jan 2026", title: "Brazil: no income tax up to R$ 5.000", text: "Salário líquido, 13º, férias and rescisão use the new reduction." },
  { date: "Jan 2026", title: "Brazil: minimum wage of R$ 1.621", text: "The INSS and wage tables were updated for the new year." },
  { date: "Jan 2026", title: "Mexico: new minimum wage and ISR table", text: "Finiquito, sueldo neto and aguinaldo use the 2026 figures." },
];

const reasons = [
  { icon: bookOpen, title: "Each country’s own rules",
    text: "Mexican, Brazilian and Gulf tools follow their own labour and tax laws, and every page links to the official source it uses." },
  { icon: lockSimple, title: "Nothing leaves your device",
    text: "The tools run in your browser. Your salary, dates and files are never uploaded or stored." },
  { icon: calendarBlank, title: "Updated every year",
    text: "Tax tables and minimum wages change every January. The calculators are updated with them, and each page shows its date." },
  { icon: checkCircle, title: "Free, with no sign-up",
    text: "No account and no paywall. Ads keep the tools free." },
];

const faqs = [
  { q: "Is Baitaan free?", a: "Yes. Every tool is free and needs no account. Ads on the pages pay for the sites." },
  { q: "Are the results official?", a: "They are estimates made with the official rules and tables of each country, and each page links to its sources. Your employer, bank or authority has the final figure." },
  { q: "Do you keep my data?", a: "No. The calculators and the PDF and photo tools work inside your browser, so your numbers and files never reach a server." },
  { q: "Why Spanish, Portuguese and Arabic?", a: "Most free tools are made in English. These sites are written for people in Mexico, Brazil and the Gulf, in their own language, with their own country’s rules." },
  { q: "Which language should I choose?", a: "Mexico: Spanish. Brazil: Portuguese. Saudi Arabia, the UAE and the rest of the Gulf: Arabic. Every tool also has an English version; use the language switch at the top of the page." },
  { q: "Do the tools work on my phone?", a: "Yes. Everything runs in your phone’s browser, with nothing to install, and the photo and PDF tools work there too." },
  { q: "Can I use a result with my employer or in a claim?", a: "A Baitaan result is an estimate, not an official document. Show the breakdown and the sources the page links to, and confirm the final figure with your employer, the authority or a professional before you rely on it." },
  { q: "How often are the tables updated?", a: "Every January, when minimum wages and tax tables change, and in February in Mexico, when the UMA changes. Each page shows the date it was last checked." },
  { q: "I found a wrong result. What do I do?", a: "Write to hello@baitaandessigns.com with the page, the figures you entered and the result you expected. Every report is checked, the page is corrected if needed, and its date is updated." },
  { q: "Can I suggest a tool?", a: "Yes, please write to us. New tools are added when many people need the same calculation." },
];
---
<Layout bleed wide title="Free calculators for Mexico, Brazil & the Gulf | Baitaan" description={`${toolCount} free tools in Spanish, Portuguese and Arabic: severance, take-home pay, 13th salary, Hijri dates, zakat, VAT, PDF and photo tools. No account needed.`}>
  <Hero
    title="Free tools that speak your language"
    lead={`${toolCount} free calculators and everyday tools for Mexico, Brazil and the Gulf, in Spanish, Portuguese and Arabic, each with an English version. No account and no paywall, and what you type into a tool stays in your browser.`}
    cta={{ href: "#all-tools", label: `Browse all ${toolCount} tools` }}
  >
    <img
      slot="visual"
      class="bt-hero-photo"
      src="/img/hero-pay-calculator.webp"
      srcset="/img/hero-pay-calculator-800.webp 800w, /img/hero-pay-calculator.webp 1600w"
      sizes="(min-width: 1024px) 540px, calc(100vw - 40px)"
      width="1600"
      height="1067"
      alt="Person checking take-home pay on a phone calculator next to a payslip"
      fetchpriority="high"
      decoding="async"
    />
  </Hero>
  <div class="mx-auto max-w-[1120px] px-5">
    <p class="bt-checked-line">
      <Icon d={checkCircle} size={16} />
      <span>Checked by a person: every calculator is reviewed by <a href="/about/#reviewer">Mian Asif Faheem</a>, founder of Baitaan, against the official law and tables it uses.</span>
    </p>
    {comingUp.length > 0 && (
      <aside class="bt-soon" aria-labelledby="soon" data-soon>
        <h2 id="soon">Coming up</h2>
        <ul>
          {comingUp.map((c) => (
            <li data-end={c.end}>
              <a href={c.href}><span class="bt-soon__place">{c.place}</span> {c.text} <strong>{c.by}</strong></a>
            </li>
          ))}
        </ul>
      </aside>
    )}
    <script is:inline>
      (function () {
        var box = document.querySelector("[data-soon]");
        if (!box) return;
        var t = new Date().toISOString().slice(0, 10);
        box.querySelectorAll("[data-end]").forEach(function (li) { if (li.getAttribute("data-end") < t) li.remove(); });
        if (!box.querySelector("li")) box.remove();
      })();
    </script>
    <div class="bt-hub-section__head bt-hub-section__head--tight">
      <h2 id="languages">Choose your language</h2>
      <p>Each site follows its own country’s laws and official tables. Pick yours, or read any tool in English.</p>
    </div>
    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3.5 p-0" aria-labelledby="languages">
      {langs.map(({ site, name, go, desc, style }) => {
        const rtl = site.dir === "rtl";
        return (
          <li>
            <a href={site.url} lang={site.lang} dir={site.dir} class="bt-card bt-lang-card min-h-[220px] gap-2.5 p-6" style={style}>
              <span class="bt-blobs" aria-hidden="true"><b></b><b></b><b></b><b></b></span>
              <span class="flex items-center gap-2.5">
                <span class="flex gap-[3px]" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="font-['IBM_Plex_Sans_Variable',sans-serif] text-[13px] text-muted">{new URL(site.url).host}</span>
              </span>
              <span class:list={["text-[34px] leading-[1.15] font-[650]", rtl ? "font-['IBM_Plex_Sans_Arabic',sans-serif]" : "tracking-[-0.02em]"]}>{name}</span>
              <span class:list={["text-base text-muted text-pretty", rtl && "font-['IBM_Plex_Sans_Arabic',sans-serif] leading-[1.7]"]}>{desc}</span>
              <span class:list={["mt-auto flex items-center justify-between gap-3 text-[15px] font-semibold", rtl && "font-['IBM_Plex_Sans_Arabic',sans-serif]"]}>
                <span>{go}</span>
                <span class="bt-lang-card__btn" data-magnet><Icon d={rtl ? arrowLeft : arrowRight} size={18} /></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mt-10"><Stats items={stats} label="Baitaan in numbers" /></div>

    <Section id="how" heading="How it works" lead="Three steps and about a minute. Nothing to install and no account.">
      <HowItWorks steps={how} />
    </Section>

    <Section id="find" heading="Find your tool in 30 seconds" lead="Start from your situation, not from a tool name.">
      <Situations items={situations} />
    </Section>

    <section class="bt-hub-section" aria-labelledby="popular">
      <div class="bt-hub-section__head">
        <h2 id="popular">Popular tools</h2>
        <p>A few of the most used calculators. Each one follows its country’s official rules and shows its sources.</p>
      </div>
      <ul class="bt-shots" data-animate="stagger">
        {popular.map((t) => (
          <li>
            <a class="bt-card bt-shot" href={t.site.url + t.path}>
              <img src={`/img/tools/${t.img}.webp`} width="960" height="600" alt={t.alt} loading="lazy" decoding="async" />
              <span class="bt-shot__body">
                <span class="bt-shot__tag" lang={t.site.lang} dir={t.site.dir}>{t.tag}</span>
