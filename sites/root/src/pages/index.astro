---
import Layout from "../components/Layout.astro";
import { SITES } from "@bt/ui/sites";

const langs = [
  { site: SITES.es, title: "Español", desc: "Calculadoras laborales para México, España y Latinoamérica" },
  { site: SITES.pt, title: "Português", desc: "Calculadoras trabalhistas para o Brasil" },
  { site: SITES.ar, title: "العربية", desc: "أدوات التاريخ الهجري والحاسبات الخليجية" },
];
---
<Layout title="Baitaan Tools: free tools in your language" description="Free calculators and everyday tools in Spanish, Portuguese and Arabic. They run in your browser, with no sign-up.">
  <h1 class="text-3xl font-bold tracking-tight">Free tools in your language</h1>
  <p class="mt-3 text-lg text-stone-600">Calculators that follow each country's own rules, running in your browser with no sign-up. Choose your language.</p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-3">
    {langs.map(({ site, title, desc }) => (
      <li>
        <a href={site.url} lang={site.lang} dir={site.dir} class="block h-full rounded-xl border border-stone-200 bg-white p-5 shadow-sm hover:border-teal-700">
          <span class="block text-xl font-semibold text-teal-800">{title}</span>
          <span class="mt-2 block text-sm text-stone-500">{desc}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
