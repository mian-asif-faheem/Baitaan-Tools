---
import Layout from "../../components/Layout.astro";
const guides = [
  { href: "/guides/severance-pay-mexico-brazil-gulf/", title: "Severance pay in Mexico, Brazil, Saudi Arabia and the UAE", text: "What you are owed when you resign or are dismissed, with one five-year example worked out under each country's rules." },
  { href: "/guides/year-end-bonus-aguinaldo-13th-salary/", title: "Year-end bonus 2026: aguinaldo and 13th salary", text: "How much, when it is paid in 2026, how it is taxed, and why the Gulf has no legal year-end bonus." },
  { href: "/guides/hijri-calendar-1448/", title: "Hijri calendar 1448 AH (Umm al-Qura)", text: "The Gregorian start date and length of every Hijri month, with Ramadan and both Eids." },
];
---
<Layout title="Guides: pay, severance and the Hijri calendar | Baitaan" description="Guides that compare the rules across Mexico, Brazil and the Gulf: severance pay, year-end bonuses and the Hijri calendar, with worked examples.">
  <article class="space-y-4 leading-relaxed text-ink">
    <h1 class="text-3xl font-bold tracking-tight text-ink">Guides</h1>
    <p class="text-lg">Each guide compares the rules across the countries Baitaan covers, with examples worked out by the same code as the calculators and links to the official sources.</p>
    <ul class="m-0 list-none space-y-3 p-0">
      {guides.map((g) => (
        <li class="bt-card p-5">
          <a class="text-lg font-semibold text-ink no-underline hover:underline" href={g.href}>{g.title}</a>
          <p class="m-0 mt-1 text-muted">{g.text}</p>
        </li>
      ))}
    </ul>
  </article>
</Layout>
