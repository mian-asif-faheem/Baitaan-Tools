---
import BaseLayout from "@bt/ui/BaseLayout.astro";
import t from "../i18n/en.json";
import "../global.css";

interface Props {
  title: string;
  description: string;
  notFound?: boolean;
  bleed?: boolean;
  wide?: boolean;
}
const { title, description, notFound = false, bleed = false, wide = false } = Astro.props;
const footer = [
  { href: "/about/", label: "About" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/contact/", label: "Contact" },
];
---
<BaseLayout site="root" wordmark glass {title} {description} code="en" lang="en" dir="ltr" {footer} footerNote="Free tools that speak your language." chrome={t.chrome} langRedirect={!notFound} {bleed} {wide}>
  <slot />
</BaseLayout>
