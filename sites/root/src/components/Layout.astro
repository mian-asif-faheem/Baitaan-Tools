---
import BaseLayout from "@bt/ui/BaseLayout.astro";
import t from "../i18n/en.json";
import "../global.css";

interface Props {
  title: string;
  description: string;
  notFound?: boolean;
}
const { title, description, notFound = false } = Astro.props;
const footer = [
  { href: "/about/", label: "About" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/contact/", label: "Contact" },
];
---
<BaseLayout site="root" {title} {description} code="en" lang="en" dir="ltr" {footer} chrome={t.chrome} langRedirect={!notFound}>
  <slot />
</BaseLayout>
