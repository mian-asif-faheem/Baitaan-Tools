---
/** Simple line drawings of each region for the hub's country cards. Decorative. */
interface Props {
  place: "mx" | "br" | "gulf";
}
const { place } = Astro.props;
---
<svg class="bt-skyline" viewBox="0 0 360 170" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M10 150h340" />
  {place === "mx" && (
    <>
      <circle cx="292" cy="40" r="16" class="bt-art-fill" />
      <rect x="40" y="70" width="44" height="80" rx="3" class="bt-art-fill" />
      <path d="M50 84h24M50 98h24M50 112h24M50 126h24" />
      <rect x="96" y="40" width="38" height="110" rx="3" class="bt-art-fill" />
      <path d="M106 54h18M106 68h18M106 82h18M106 96h18M106 110h18M106 124h18" />
      <path d="M176 150v-22h28v22M182 128V58h16v70M178 58h24M190 58V36" />
      <path d="M183 36c3-6 11-6 14 0M190 30l-9-5M190 30l9-5" />
      <rect x="230" y="88" width="56" height="62" rx="3" class="bt-art-fill" />
      <path d="M240 102h36M240 116h36M240 130h36" />
      <rect x="298" y="104" width="34" height="46" rx="3" class="bt-art-fill" />
    </>
  )}
  {place === "br" && (
    <>
      <circle cx="80" cy="42" r="16" class="bt-art-fill" />
      <path d="M200 150c6-40 22-96 52-96s44 50 52 96" class="bt-art-fill" />
      <path d="M150 150c4-24 14-46 30-46s22 20 26 46" class="bt-art-fill" />
      <path d="M180 104 252 54" stroke-dasharray="4 6" />
      <rect x="28" y="80" width="40" height="70" rx="3" class="bt-art-fill" />
      <path d="M38 94h20M38 108h20M38 122h20M38 136h20" />
      <rect x="78" y="62" width="36" height="88" rx="3" class="bt-art-fill" />
      <path d="M88 76h16M88 90h16M88 104h16M88 118h16M88 132h16" />
      <path d="M310 150v-36M310 114c-10-4-20 0-24 8M310 114c10-4 20 0 24 8M310 114c-6-10-2-18 6-20M310 114c6-10 2-18-6-20" />
    </>
  )}
  {place === "gulf" && (
    <>
      <circle cx="300" cy="40" r="16" class="bt-art-fill" />
      <path d="M86 150V60l8-36 8 36v90" class="bt-art-fill" />
      <path d="M94 24v-12M86 80h16M86 110h16" />
      <rect x="120" y="76" width="40" height="74" rx="3" class="bt-art-fill" />
      <path d="M130 90h20M130 104h20M130 118h20M130 132h20" />
      <path d="M186 150v-34h70v34" class="bt-art-fill" />
      <path d="M196 116c0-22 50-22 50 0" class="bt-art-fill" />
      <path d="M221 94v-8M270 150V70M264 70h12M266 70l4-14 4 14M264 96h12" />
      <rect x="30" y="98" width="40" height="52" rx="3" class="bt-art-fill" />
      <path d="M320 150v-34M320 116c-10-4-20 0-24 8M320 116c10-4 20 0 24 8M320 116c-6-10-2-18 6-20M320 116c6-10 2-18-6-20" />
    </>
  )}
</svg>
