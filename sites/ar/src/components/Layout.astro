---
import BaseLayout from "@bt/ui/BaseLayout.astro";
import arabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import arabic700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url";
import { NATIVE, dirOf, getT, versionsFor, type Lang } from "../i18n";
import "../global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 404 pages: no language redirect, switcher points to the other home page. */
  notFound?: boolean;
  /** Page lays out its own full-width sections (tool and home pages). */
  bleed?: boolean;
  /** Wide footer for home pages. */
  wide?: boolean;
}
const { title, description, lang = NATIVE, notFound = false, bleed = false, wide = false } = Astro.props;
const t = getT(lang);
const versions = versionsFor(notFound ? (lang === "en" ? "/en/" : "/") : Astro.url.pathname);
---
<BaseLayout
  site="ar" preload={[arabic700, arabic400]}
  wordmark
  {title}
  {description}
  code={lang}
  lang={lang}
  dir={dirOf(lang)}
  {versions}
  nav={t.nav}
  footer={t.footer}
  footerNote={t.footerNote}
  brand={t.brand}
  homeHref={lang === "en" ? "/en/" : "/"}
  chrome={t.chrome}
  langRedirect={!notFound}
  {bleed}
  {wide}
>
  <slot />
</BaseLayout>
