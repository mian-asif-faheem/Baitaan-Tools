---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import WordCounter from "../../components/WordCounter.tsx";
---
<Layout
  lang="en"
  title="Arabic word and character counter, with diacritics removal | Baitaan"
  description="Count the words, characters, sentences and paragraphs in Arabic or English text, count the diacritics (tashkeel) and remove them in one click. Free, no sign-up."
>
  <ToolPage
    heading="Word and character counter"
    lead="Paste your text to see the number of words and characters, with and without spaces, and the number of diacritics. You can also strip all the diacritics in one click."
    updated="Updated: November 2026"
  >
    <WordCounter client:load lang="en" />

    <Fragment slot="guide">
      <h2>Why a counter built for Arabic?</h2>
      <p>Many counters treat diacritics (tashkeel) as letters, so vowelled Arabic text looks longer than it is. This tool shows the character count with and without diacritics, so you know the real length. It works for English text too.</p>

      <h2>Uses</h2>
      <ul>
        <li>Keeping to the word limit for articles, papers and assignments.</li>
        <li>Writing posts, product descriptions and ads of a set length.</li>
        <li>Removing diacritics before searching or pasting into systems that don't support them.</li>
      </ul>

      <AdSlot slot="0000000000" label="Advertisement" />

      <h2>How are sentences counted?</h2>
      <p>A sentence ends at each full stop, question mark (؟ or ?), exclamation mark or new line. Paragraphs are separated by a blank line.</p>
    </Fragment>
  </ToolPage>
</Layout>
