---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import VatCalc from "../../components/VatCalc.tsx";
---
<Layout
  bleed
  lang="en"
  title="VAT calculator: Saudi Arabia 15% and UAE 5% | Baitaan"
  description="Add VAT to a price or extract it from a VAT-inclusive amount: Saudi Arabia 15%, UAE 5%, Bahrain 10%, Oman 5%. Free, no sign-up."
>
  <ToolPage
    heading="VAT calculator (Gulf)"
    lead="To add VAT, multiply the amount by (1 + the rate). To extract it from a VAT-inclusive amount, divide by (1 + the rate); the difference is the VAT."
    updated="Updated: November 2026"
    sourcesHeading="Sources"
    sources={[
      { href: "https://zatca.gov.sa/", label: "Zakat, Tax and Customs Authority (Saudi Arabia)" },
      { href: "https://tax.gov.ae/", label: "Federal Tax Authority (UAE)" },
    ]}
  >
    <VatCalc client:load lang="en" />

    <Fragment slot="guide">
      <h2>VAT rates in the Gulf</h2>
      <ul>
        <li>Saudi Arabia: 15%</li>
        <li>UAE: 5%</li>
        <li>Bahrain: 10%</li>
        <li>Oman: 5%</li>
        <li>Qatar and Kuwait: no VAT yet.</li>
      </ul>

      <h2>Examples</h2>
      <ul>
        <li>A price of SAR 1,000 before VAT in Saudi Arabia: VAT 150, total <strong>SAR 1,150</strong>.</li>
        <li>An invoice of SAR 1,150 including VAT: amount before VAT 1,150 ÷ 1.15 = 1,000, VAT <strong>SAR 150</strong>.</li>
        <li>AED 210 including VAT in the UAE: 210 ÷ 1.05 = 200, VAT <strong>AED 10</strong>.</li>
      </ul>

      <AdSlot unit="0000000000" label="Advertisement" />

      <h2>A common mistake</h2>
      <p>Don't work out the VAT by multiplying the inclusive amount by 15%. On a SAR 1,150 invoice that gives 172.50, while the correct VAT is SAR 150. Divide by 1.15 first.</p>

      <h2>Frequently asked questions</h2>
      <details class="bt-faq"><summary>Since when is VAT 15% in Saudi Arabia?</summary><p>Since 1 July 2020, when it rose from 5%. The UAE has charged 5% since 2018, Bahrain 10% since January 2022 and Oman 5% since April 2021.</p></details>
      <details class="bt-faq"><summary>Do shop prices include VAT?</summary><p>In Saudi Arabia and the UAE, prices shown to consumers must include VAT, so choose “Including VAT” to see the tax inside a price.</p></details>
      <details class="bt-faq"><summary>What should a tax invoice show?</summary><p>The amount before VAT, the VAT and the total, with the seller's VAT number. In Saudi Arabia, e-invoices to consumers also carry a QR code you can scan.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
