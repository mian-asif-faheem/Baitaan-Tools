---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../../components/Layout.astro";
import HomeExtras from "../../components/HomeExtras.astro";
import PhoneShot from "@bt/ui/sections/PhoneShot.astro";
import { toHijri, HIJRI_MONTHS_EN } from "@bt/tools/hijri";

// Today's Hijri date as of the build; the script below refreshes it in the browser.
const h = toHijri(new Date());
const today = `${h.day} ${HIJRI_MONTHS_EN[h.month - 1]} ${h.year}\u00a0AH`;

const groups: Group[] = [
  {
    title: "Hijri dates and occasions",
    featured: {
      href: "/en/tahweel-altareekh/",
      name: "Hijri date converter",
      desc: "Gregorian to Hijri and back, Umm al-Qura calendar",
      exampleLabel: "Today",
      example: today,
      exampleId: "bt-today"
    },
    tools: [
      {
        href: "/en/kam-baqi-ala-ramadan/",
        name: "How long until Ramadan",
        desc: "Countdown in days and hours"
      },
      {
        href: "/en/kam-baqi-ala-eid-alfitr/",
        name: "How long until Eid al-Fitr"
      },
      {
        href: "/en/kam-baqi-ala-eid-aladha/",
        name: "How long until Eid al-Adha",
        desc: "With the date of the Day of Arafah"
      },
      {
        href: "/en/hisab-alumr-bilhijri/",
        name: "Hijri age calculator",
        desc: "Your age in both calendars"
      },
      {
        href: "/en/alfarq-bayna-tarikhayn/",
        name: "Days between two dates",
        desc: "Days, months and working days"
      }
    ]
  },
  {
    title: "Work and money",
    tools: [
      {
        href: "/en/nihayat-alkhidma-saudi/",
        name: "End-of-service award · Saudi Arabia",
        desc: "On resignation or end of contract"
      },
      {
        href: "/en/nihayat-alkhidma-uae/",
        name: "End-of-service gratuity · UAE",
        desc: "Under the new Labour Law"
      },
      {
        href: "/en/hasibat-addariba/",
        name: "VAT calculator",
        desc: "Add or extract VAT"
      },
      {
        href: "/en/hasibat-azzakat/",
        name: "Zakat calculator",
        desc: "Nisab by the price of gold or silver"
      }
    ]
  },
  {
    title: "Documents and text",
    tools: [
      {
        href: "/en/maqas-assura/",
        name: "Photo size for printing",
        desc: "4×6, 3.5×4.5 and more"
      },
      {
        href: "/en/dagt-pdf/",
        name: "Compress PDF",
        desc: "To 1 MB or less"
      },
      {
        href: "/en/damj-pdf/",
        name: "Merge PDF",
        desc: "Files and photos into one file"
      },
      {
        href: "/en/adad-alkalimat/",
        name: "Arabic word counter",
        desc: "Counts and removes diacritics"
      }
    ]
  }
];
---
<Layout bleed wide lang="en" title="Free tools for the Gulf, in English | Baitaan" description="Free tools and calculators that run in your browser, no sign-up: Hijri date converter, Ramadan countdown, Saudi and UAE end-of-service, VAT, zakat and PDF.">
  <Hero title="Free tools for the Gulf, no sign-up" lead="Calculators and tools for Saudi Arabia, the UAE and the Gulf that run in your browser. Your data never leaves your device." cta={{ href: "/en/tahweel-altareekh/", label: "Convert a date now" }}>
    <PhoneShot slot="visual" title="End-of-service benefit" label="Award · contract ended after 7 years" value="SAR 36,000" rows={[["First 5 years", "SAR 20,000"], ["Next 2 years", "SAR 16,000"]]} />
  </Hero>
  <HomeExtras lang="en" part="top" />
  <ToolGrid {groups} />
  <HomeExtras lang="en" part="bottom" />
</Layout>

<script>
  import { toHijri, HIJRI_MONTHS_EN } from "@bt/tools/hijri";
  const el = document.getElementById("bt-today");
  const h = toHijri(new Date());
  if (el) el.textContent = `${h.day} ${HIJRI_MONTHS_EN[h.month - 1]} ${h.year}\u00a0AH`;
</script>
