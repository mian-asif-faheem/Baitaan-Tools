---
import Hero from "@bt/ui/Hero.astro";
import Layout from "../../components/Layout.astro";

const groups = [
  {
    title: "Hijri dates and occasions",
    tools: [
      { href: "/en/tahweel-altareekh/", name: "Hijri date converter", desc: "Gregorian to Hijri and back, Umm al-Qura calendar" },
      { href: "/en/kam-baqi-ala-ramadan/", name: "How long until Ramadan", desc: "Countdown in days and hours" },
      { href: "/en/kam-baqi-ala-eid-alfitr/", name: "How long until Eid al-Fitr", desc: "" },
      { href: "/en/kam-baqi-ala-eid-aladha/", name: "How long until Eid al-Adha", desc: "With the date of the Day of Arafah" },
      { href: "/en/hisab-alumr-bilhijri/", name: "Hijri age calculator", desc: "Your age in both calendars" },
      { href: "/en/alfarq-bayna-tarikhayn/", name: "Days between two dates", desc: "Days, months and working days" },
    ],
  },
  {
    title: "Work and money",
    tools: [
      { href: "/en/nihayat-alkhidma-saudi/", name: "End-of-service award · Saudi Arabia", desc: "On resignation or end of contract" },
      { href: "/en/nihayat-alkhidma-uae/", name: "End-of-service gratuity · UAE", desc: "Under the new Labour Law" },
      { href: "/en/hasibat-addariba/", name: "VAT calculator", desc: "Add or extract VAT" },
      { href: "/en/hasibat-azzakat/", name: "Zakat calculator", desc: "Nisab by the price of gold or silver" },
    ],
  },
  {
    title: "Documents and text",
    tools: [
      { href: "/en/maqas-assura/", name: "Photo size for printing", desc: "4×6, 3.5×4.5 and more" },
      { href: "/en/dagt-pdf/", name: "Compress PDF", desc: "To 1 MB or less" },
      { href: "/en/damj-pdf/", name: "Merge PDF", desc: "Files and photos into one file" },
      { href: "/en/adad-alkalimat/", name: "Arabic word counter", desc: "Counts and removes diacritics" },
    ],
  },
];
---
<Layout lang="en" title="Free tools for the Gulf, in English | Baitaan" description="Free tools and calculators that run in your browser, no sign-up: Hijri date converter, Ramadan countdown, Saudi and UAE end-of-service, VAT, zakat and PDF.">
  <Hero title="Free tools for the Gulf, no sign-up" lead="Calculators and tools for Saudi Arabia, the UAE and the Gulf that run in your browser. Your data never leaves your device." />
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a href={tool.href} class="relative isolate block h-full overflow-hidden rounded-xl border border-stone-200 bg-white p-5 shadow-sm hover:border-teal-700" data-spotlight>
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  import { spotlightAll } from "@bt/ui/fx/spotlight";
  spotlightAll();
</script>
