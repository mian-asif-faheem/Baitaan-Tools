---
import Layout from "../../components/Layout.astro";
---
<Layout lang="en" notFound title="Page not found | Baitaan" description="The page you're looking for doesn't exist.">
  <div class="py-10 text-center">
    <p class="text-6xl font-bold text-teal-800">404</p>
    <h1 class="mt-4 text-2xl font-bold">This page doesn't exist</h1>
    <p class="mt-3 text-stone-600">The address may be wrong, or the page has moved.</p>
    <a href="/en/" class="mt-6 inline-block rounded-lg bg-teal-700 px-5 py-2.5 font-semibold text-white hover:bg-teal-800">See all tools</a>
  </div>
</Layout>
