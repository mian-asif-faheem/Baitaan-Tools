---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import Countdown from "../../components/Countdown.tsx";
import { nextHijriOccurrence } from "@bt/tools/hijri-dates";
import { toGregorian } from "@bt/tools/hijri";

const next = nextHijriOccurrence(12, 10);
const y = next.hijri.year;
const gYear = next.gregorian.getUTCFullYear();
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", weekday: "long", timeZone: "UTC" });
const arafah = fmt.format(toGregorian({ year: y, month: 12, day: 9 }));
const tarwiyah = fmt.format(toGregorian({ year: y, month: 12, day: 8 }));
---
<Layout
  bleed
  lang="en"
  title={`How long until Eid al-Adha ${gYear}? Day of Arafah too | Baitaan`}
  description={`Countdown to Eid al-Adha ${y} AH (10 Dhu al-Hijjah), with the expected date of the Day of Arafah from the Umm al-Qura calendar.`}
>
  <ToolPage
    heading={`How long until Eid al-Adha ${gYear}?`}
    lead={`Eid al-Adha falls on 10 Dhu al-Hijjah, after the Day of Arafah on 9 Dhu al-Hijjah. This is the expected date for ${y} AH under the Umm al-Qura calendar.`}
    updated="The countdown updates every second"
  >
    <Countdown client:load month={12} day={10} name="Eid al-Adha" lang="en" />

    <Fragment slot="guide">
      <h2>Expected Hajj days for {y} AH</h2>
      <ul>
        <li>Day of Tarwiyah (8 Dhu al-Hijjah): {tarwiyah}</li>
        <li>Day of Arafah (9 Dhu al-Hijjah): {arafah}</li>
        <li>Eid al-Adha (10 Dhu al-Hijjah): {fmt.format(next.gregorian)}</li>
      </ul>
      <p>Saudi Arabia's Supreme Court announces the start of Dhu al-Hijjah after the moon sighting, so these dates may differ by one day.</p>

      <AdSlot unit="0000000000" label="Advertisement" />

      <h2>Coming dates</h2>
      <ul>
        <li><a class="text-link underline" href="/en/kam-baqi-ala-ramadan/">How long until Ramadan</a></li>
        <li><a class="text-link underline" href="/en/kam-baqi-ala-eid-alfitr/">How long until Eid al-Fitr</a></li>
      </ul>

      <h2>How the countdown works</h2>
      <p>It counts down to midnight, Makkah time, at the start of 10 Dhu al-Hijjah {y} AH, {fmt.format(next.gregorian)} on the Umm al-Qura calendar. After Eid it moves on to the following year.</p>
      <h2>Frequently asked questions</h2>
      <details class="bt-faq"><summary>When is the Day of Arafah?</summary><p>On 9 Dhu al-Hijjah, the day before Eid: {arafah} on the Umm al-Qura calendar. Pilgrims stand at Arafat, and many people who are not on Hajj fast that day.</p></details>
      <details class="bt-faq"><summary>When can the sacrifice (udhiyah) be offered?</summary><p>From after the Eid prayer on 10 Dhu al-Hijjah until sunset on 13 Dhu al-Hijjah, the last of the days of Tashreeq, in the view of many scholars.</p></details>
      <details class="bt-faq"><summary>How long after Eid al-Fitr does Eid al-Adha come?</summary><p>About two months and ten days: the rest of Shawwal, all of Dhu al-Qadah and the first ten days of Dhu al-Hijjah, between 67 and 69 days.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
