---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import HijriConverter from "../components/HijriConverter.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="تحويل التاريخ من ميلادي إلى هجري وبالعكس | بيتان"
  description="حوّل أي تاريخ من الميلادي إلى الهجري أو من الهجري إلى الميلادي حسب تقويم أم القرى. مجاني ودون تسجيل."
>
  <ToolPage
    heading="تحويل التاريخ الهجري والميلادي"
    lead="اختر الاتجاه وأدخل التاريخ لتحصل على التاريخ المقابل واسم اليوم فورًا، حسب تقويم أم القرى."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="المصادر"
    sources={[{ href: "https://www.ummulqura.org.sa/", label: "تقويم أم القرى" }]}
  >
    <HijriConverter client:load />

    <Fragment slot="guide">
      <h2>ما هو تقويم أم القرى؟</h2>
      <p>تقويم أم القرى هو التقويم الهجري الرسمي في المملكة العربية السعودية. يُحسب مسبقًا اعتمادًا على الحسابات الفلكية، لذلك قد يختلف بداية الشهر بيوم واحد في الدول التي تعتمد رؤية الهلال.</p>

      <h2>لماذا يختلف عدد أيام الشهر الهجري؟</h2>
      <p>الشهر الهجري 29 أو 30 يومًا، والسنة الهجرية نحو 354 يومًا، أي أقصر من السنة الميلادية بنحو 11 يومًا.</p>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>أمثلة حسب تقويم أم القرى</h2>
      <ul>
        <li>1 محرّم 1447 هـ = 26 يونيو 2025</li>
        <li>1 رمضان 1447 هـ = 18 فبراير 2026</li>
        <li>1 شوال 1447 هـ (عيد الفطر) = 20 مارس 2026</li>
        <li>1 محرّم 1448 هـ = 16 يونيو 2026</li>
      </ul>
      <h2>تقدير سريع دون أداة</h2>
      <p>السنة الميلادية ≈ السنة الهجرية − (السنة الهجرية ÷ 33) + 622. فمثلًا 1448 − 43.9 + 622 ≈ 2026، وقد بدأت سنة 1448 هـ فعلًا في يونيو 2026. واستخدم الأداة لمعرفة اليوم بدقة.</p>
      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>ما أسماء الأشهر الهجرية؟</summary><p>بالترتيب: محرّم، صفر، ربيع الأول، ربيع الآخر، جمادى الأولى، جمادى الآخرة، رجب، شعبان، رمضان، شوال، ذو القعدة، ذو الحجة.</p></details>
      <details class="bt-faq"><summary>لماذا يختلف التاريخ يومًا عن موقع آخر؟</summary><p>بعض المواقع تعتمد تقويمًا هجريًا حسابيًا ثابتًا أو رؤية الهلال المحلية بدل أم القرى. أما هذه الأداة فتعتمد تقويم أم القرى، التقويم الرسمي في السعودية.</p></details>
      <details class="bt-faq"><summary>هل تصلح لتواريخ الميلاد والوثائق؟</summary><p>نعم. ولحساب العمر بالتقويمين استخدم <a class="text-link underline" href="/hisab-alumr-bilhijri/">حاسبة العمر بالهجري</a>.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
