---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import WordCounter from "../components/WordCounter.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="عداد الكلمات والحروف العربية مع إزالة التشكيل | بيتان"
  description="احسب عدد الكلمات والحروف والجمل والفقرات في النص العربي، مع عدّ علامات التشكيل وإزالتها بنقرة. مجاني ودون تسجيل."
>
  <ToolPage
    heading="عداد الكلمات والحروف"
    lead="الصق نصك لتعرف فورًا عدد الكلمات والحروف مع المسافات ودونها، وعدد علامات التشكيل. يمكنك أيضًا إزالة التشكيل من النص كله بنقرة واحدة."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <WordCounter client:load />

    <Fragment slot="guide">
      <h2>لماذا عداد مخصص للعربية؟</h2>
      <p>كثير من العدادات تحسب علامات التشكيل حروفًا، فيظهر النص المشكول أطول من طوله الحقيقي. هذه الأداة تعرض عدد الحروف مع التشكيل ودونه، فتعرف الطول الحقيقي لنصك.</p>

      <h2>استخدامات</h2>
      <ul>
        <li>الالتزام بحد الكلمات في المقالات والأبحاث والواجبات.</li>
        <li>كتابة التغريدات ووصف المنتجات والإعلانات بطول محدد.</li>
        <li>إزالة التشكيل قبل البحث أو اللصق في أنظمة لا تدعمه.</li>
      </ul>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>كيف تُعدّ الجمل؟</h2>
      <p>تُعدّ الجملة عند كل نقطة أو علامة استفهام (؟ أو ?) أو علامة تعجب أو سطر جديد. أما الفقرات فيفصل بينها سطر فارغ.</p>

      <h2>مثال</h2>
      <p>النص: «الحمدُ للهِ ربِّ العالمين. هذه أداةٌ مجانيةٌ لعدِّ الكلمات.»</p>
      <ul class="ms-5 list-disc space-y-1">
        <li>الكلمات: 9.</li>
        <li>الحروف مع المسافات والتشكيل: 59.</li>
        <li>علامات التشكيل: 8، فيكون عدد الحروف دون التشكيل 51.</li>
        <li>الجمل: 2، لأن النص فيه نقطتان.</li>
      </ul>
      <p>لو حسبت التشكيل حروفًا لظهر النص أطول بثماني علامات مما هو فعلًا.</p>
      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>لماذا يختلف العدد عن برنامج Word؟</summary><p>يعدّ Word الكلمات بالمسافات، وقد يحسب «و» أو الأرقام أو الرموز المفصولة بمسافة كلمات مستقلة. هذه الأداة تعدّ أيضًا بالمسافات، لكنها لا تحسب علامات الترقيم وحدها كلمات، لذلك قد يختلف العدد قليلًا.</p></details>
      <details class="bt-faq"><summary>هل يُحسب التشكيل؟</summary><p>يظهر عدد الحروف بالتشكيل ودونه، ويظهر عدد علامات التشكيل وحده. أما عدد الكلمات فلا يتأثر بالتشكيل.</p></details>
      <details class="bt-faq"><summary>هل «وقال» كلمة أم كلمتان؟</summary><p>كلمة واحدة، لأنها مكتوبة متصلة دون مسافة. الأداة تعدّ ما بين المسافات كلمة، كما تفعل أغلب المنصات وحدود الكلمات في الجامعات.</p></details>
      <details class="bt-faq"><summary>هل يُحفظ نصي؟</summary><p>لا. العدّ يتم في متصفحك ولا يُرسل النص إلى أي خادم.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
