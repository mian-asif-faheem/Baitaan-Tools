---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import WordCounter from "../components/WordCounter.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="عداد الكلمات والحروف العربية مع إزالة التشكيل | بيتان"
  description="احسب عدد الكلمات والحروف والجمل والفقرات في النص العربي، مع عدّ علامات التشكيل وإزالتها بنقرة. مجاني ودون تسجيل."
>
  <ToolPage
    heading="عداد الكلمات والحروف"
    lead="الصق نصك لتعرف فورًا عدد الكلمات والحروف مع المسافات ودونها، وعدد علامات التشكيل. يمكنك أيضًا إزالة التشكيل من النص كله بنقرة واحدة."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <WordCounter client:load />

    <Fragment slot="guide">
      <h2>لماذا عداد مخصص للعربية؟</h2>
      <p>كثير من العدادات تحسب علامات التشكيل حروفًا، فيظهر النص المشكول أطول مما هو. هذه الأداة تعرض عدد الحروف مع التشكيل ودونه، فتعرف الطول الحقيقي لنصك.</p>

      <h2>استخدامات</h2>
      <ul>
        <li>الالتزام بحد الكلمات في المقالات والأبحاث والواجبات.</li>
        <li>كتابة التغريدات ووصف المنتجات والإعلانات بطول محدد.</li>
        <li>إزالة التشكيل قبل البحث أو اللصق في أنظمة لا تدعمه.</li>
      </ul>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>كيف تُعدّ الجمل؟</h2>
      <p>تُعدّ الجملة عند كل نقطة أو علامة استفهام (؟ أو ?) أو علامة تعجب أو سطر جديد. أما الفقرات فيفصل بينها سطر فارغ.</p>
    </Fragment>
  </ToolPage>
</Layout>
