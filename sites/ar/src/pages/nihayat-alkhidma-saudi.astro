---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import Summary from "@bt/ui/sections/Summary.astro";
import SplitBar from "@bt/ui/sections/SplitBar.astro";
import Steps from "@bt/ui/sections/Steps.astro";
import Checklist from "@bt/ui/sections/Checklist.astro";
import EosCalc from "../components/EosCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="حساب مكافأة نهاية الخدمة في السعودية 2026 | بيتان"
  description="احسب مكافأة نهاية الخدمة وفق نظام العمل السعودي: عند الاستقالة أو إنهاء العقد، مع الثلث والثلثين والمكافأة الكاملة. مجاني ودون تسجيل."
>
  <ToolPage
    heading="حساب مكافأة نهاية الخدمة في السعودية"
    lead="يستحق العامل نصف أجر شهر عن كل سنة من السنوات الخمس الأولى، وأجر شهر كامل عن كل سنة بعدها. وعند الاستقالة يأخذ الثلث أو الثلثين أو المكافأة كاملة بحسب مدة خدمته."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="المصادر"
    sources={[{ href: "https://hrsd.gov.sa/en/knowledge-centre/articles/317", label: "وزارة الموارد البشرية: لائحة مكافأة نهاية الخدمة" }]}
  >
    <EosCalc client:load country="sa" />

    <Fragment slot="guide">
      <Summary heading="باختصار" items={[
        { label: "إذا أنهى صاحب العمل العقد", title: "المكافأة كاملة", text: "نصف أجر شهر عن كل سنة من الخمس الأولى، وأجر شهر عن كل سنة بعدها.", featured: true },
        { label: "إذا استقلت", title: "ثلث أو ثلثان أو كاملة", text: "بحسب مدة الخدمة، ولا شيء قبل سنتين." },
        { label: "موعد الصرف", title: "خلال أسبوع أو أسبوعين", text: "أسبوع إذا أنهى صاحب العمل العقد، وأسبوعان عند الاستقالة (المادة 88)." },
      ]} />

      <h2>طريقة الحساب (المادة 84)</h2>
      <ul>
        <li>نصف أجر شهر عن كل سنة من السنوات الخمس الأولى.</li>
        <li>أجر شهر كامل عن كل سنة بعد السنوات الخمس.</li>
        <li>تُحسب أجزاء السنة بنسبتها.</li>
        <li>الأجر المعتمد هو آخر أجر فعلي: الأساسي مع بدل السكن والنقل وكل البدلات المستحقة، وليس الأساسي وحده.</li>
      </ul>

      <h2>الاستقالة (المادة 85)</h2>
      <ul>
        <li>أقل من سنتين: لا مكافأة.</li>
        <li>من سنتين إلى خمس سنوات: ثلث المكافأة.</li>
        <li>أكثر من خمس سنوات وأقل من عشر: ثلثا المكافأة.</li>
        <li>عشر سنوات فأكثر: المكافأة كاملة.</li>
      </ul>
      <p>وتُصرف المكافأة كاملة رغم الاستقالة في حالة القوة القاهرة، وللعاملة التي تنهي عقدها خلال 6 أشهر من زواجها أو 3 أشهر من وضعها (المادة 87).</p>

      <h2>أمثلة</h2>
      <ul>
        <li>إنهاء العقد بعد 7 سنوات، والأجر الفعلي 8,000 ريال (6,000 أساسي و1,500 سكن و500 نقل): 5 × 4,000 + 2 × 8,000 = <strong>36,000 ريال</strong>. ولو حُسبت على الأساسي وحده لكانت 27,000 ريال فقط.</li>
        <li>استقالة بعد 4 سنوات بأجر 6,000 ريال: المكافأة الكاملة 12,000، ويستحق الثلث: <strong>4,000 ريال</strong>.</li>
        <li>استقالة بعد 8 سنوات بأجر 10,000 ريال: المكافأة الكاملة 55,000، ويستحق الثلثين: <strong>36,666.67 ريال</strong>.</li>
      </ul>

      <p>كيف تتوزع مكافأة المثال الأول (36,000 ريال):</p>
      <SplitBar label="توزيع المثال الأول" parts={[{ label: "أول 5 سنوات بنصف أجر", value: 20000, display: "20,000 ريال" }, { label: "السنتان التاليتان بأجر كامل", value: 16000, display: "16,000 ريال" }]} />

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>عند انتهاء خدمتك: خطوة بخطوة</h2>
      <Steps items={[
        { title: "تأكد من أجرك الفعلي", text: "المكافأة تُحسب على آخر أجر شامل البدلات المستحقة، لا على الأساسي وحده." },
        { title: "احسب المكافأة واحفظ النتيجة", text: "استخدم الحاسبة أعلاه وقارن النتيجة بما يعرضه صاحب العمل." },
        { title: "انتظر الصرف في موعده", text: "خلال أسبوع إذا أنهى صاحب العمل العقد، وخلال أسبوعين عند الاستقالة (المادة 88)." },
        { title: "عند الخلاف: التسوية الودية", text: "قدّم الطلب لدى وزارة الموارد البشرية. وإذا لم يُتفق خلال 21 يوم عمل من أول جلسة، تُحال القضية إلى المحكمة العمالية." },
      ]} />

      <h2>جهّز ما يلي</h2>
      <Checklist items={["عقد العمل", "تاريخ المباشرة وآخر يوم عمل", "آخر مسيّر رواتب يوضح البدلات", "خطاب الاستقالة أو إنهاء العقد"]} />

      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>متى يجب صرف المكافأة؟</summary><p>خلال أسبوع من انتهاء العلاقة إذا أنهاها صاحب العمل، وخلال أسبوعين إذا كانت الاستقالة من العامل (المادة 88).</p></details>
      <details class="bt-faq"><summary>هل تشمل المكافأة بدل السكن؟</summary><p>نعم. يُحسب على الأجر الفعلي الذي يشمل البدلات المستحقة، إلا ما اتفق الطرفان على استثنائه من العمولات ونحوها.</p></details>
      <details class="bt-faq"><summary>هل أستحق مكافأة إذا انتهى عقدي خلال فترة التجربة؟</summary><p>لا، لا تُستحق مكافأة نهاية الخدمة إذا انتهى العقد خلال فترة التجربة.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
