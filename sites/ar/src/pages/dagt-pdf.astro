---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import PdfCompressTool from "@bt/ui/PdfCompressTool.tsx";
import t from "../i18n/ar.json";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="ضغط ملف PDF إلى 1 ميغابايت أو أقل مجانًا | بيتان"
  description="قلّل حجم ملف PDF إلى 1 أو 2 ميغابايت أو الحجم الذي تطلبه المنصة، دون رفع الملف إلى أي خادم. مجاني ودون تسجيل."
>
  <ToolPage
    heading="ضغط ملف PDF"
    lead="اختر الملف والحجم الأقصى الذي تطلبه المنصة، وتضغطه الأداة داخل متصفحك دون رفعه إلى أي خادم."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="كيف صُنعت الأداة"
    sources={[{ href: "https://mozilla.github.io/pdf.js/", label: "مكتبة PDF.js من Mozilla: تقرأ كل صفحة وترسمها في متصفحك" }, { href: "https://pdf-lib.js.org/", label: "مكتبة pdf-lib: تُنشئ ملف PDF الجديد في متصفحك أيضًا" }]}
  >
    <PdfCompressTool client:visible t={t.pdf} targets={[0.5, 1, 2, 5]} defaultTarget={1} locale="ar-SA-u-nu-latn" />

    <Fragment slot="guide">
      <h2>متى تحتاجها؟</h2>
      <p>كثير من المنصات الحكومية والجامعات وبوابات التوظيف تحدد حجم المرفقات بـ 1 أو 2 ميغابايت، بينما تتجاوز الملفات الممسوحة بالجوال هذا الحجم غالبًا.</p>

      <h2>كيف تعمل؟</h2>
      <p>تحوّل الأداة كل صفحة إلى صورة JPG بجودة جيدة ثم تُنشئ ملف PDF جديدًا، وتبدأ بأعلى جودة ثم تخفضها تدريجيًا حتى تصل إلى الحجم المطلوب. وتناسب هذه الطريقة أكثر المستندات الممسوحة وصور الهويات.</p>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>نصائح</h2>
      <ul>
        <li>احذف الصفحات غير المطلوبة إذا كان الملف طويلًا.</li>
        <li>لدمج الهوية والشهادة في ملف واحد استخدم <a class="text-link underline" href="/damj-pdf/">دمج PDF</a> ثم اضغط الناتج.</li>
        <li>افتح الملف المضغوط قبل إرساله وتأكد أن الأرقام والتواقيع واضحة.</li>
      </ul>

      <h2>خطوة بخطوة</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>اختر ملف PDF.</li>
        <li>اختر الحجم الذي تطلبه المنصة: 0.5 أو 1 أو 2 أو 5 ميغابايت، أو حجمًا آخر.</li>
        <li>اضغط زر «ضغط» وانتظر حتى تُعالَج كل صفحة.</li>
        <li>نزّل الملف وافتحه للتأكد من وضوحه.</li>
      </ol>
      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>لماذا ما زال الملف أكبر من الحد؟</summary><p>يحدث ذلك مع المستندات الطويلة أو الصفحات المليئة بالصور. تعطيك الأداة أصغر حجم ممكن؛ احذف الصفحات غير المطلوبة أو قسّم المستند ثم أعد المحاولة.</p></details>
      <details class="bt-faq"><summary>هل سيبقى المستند واضحًا؟</summary><p>تحافظ الأداة على أفضل جودة تناسب الحجم المختار. قبل الإرسال كبّر الأرقام والتواقيع، فإن ظهرت غير واضحة فاختر حجمًا أكبر أو احذف بعض الصفحات.</p></details>
      <details class="bt-faq"><summary>هل تعمل على الجوال؟</summary><p>نعم، في متصفح الجوال دون تثبيت أي شيء.</p></details>
      <details class="bt-faq"><summary>هل يُحفظ مستندي في أي مكان؟</summary><p>لا. يُعالَج على جهازك ولا يُحفَظ بعد إغلاق الصفحة.</p></details>
      <details class="bt-faq"><summary>هل تعمل الأداة مع الملفات المحمية بكلمة مرور؟</summary><p>لا. أزل كلمة المرور أولًا من التطبيق الذي أُنشئ فيه الملف، ثم اضغطه، لأن الأداة لا تستطيع فتح الملفات المحمية داخل المتصفح.</p></details>

      <h2>مثال</h2>
      <p>مستند ممسوح بالجوال من 6 صفحات حجمه 4 ميغابايت، والمنصة تقبل 1 ميغابايت فقط. تحوّل الأداة كل صفحة إلى صورة JPG، وتجرّب مستويات الجودة من الأعلى إلى الأدنى حتى يصبح الملف أقل من 1 ميغابايت، أي نحو 170 كيلوبايت لكل صفحة. النص المكتوب يبقى مقروءًا، لكنه يصبح صورة، فلا يمكن نسخه أو البحث فيه بعد الضغط.</p>
    </Fragment>
  </ToolPage>
</Layout>
