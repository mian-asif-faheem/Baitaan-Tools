---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import ZakatCalc from "../components/ZakatCalc.tsx";
---
<!-- TODO (native review): Arabic copy, and a scholar's review of the guide. -->
<Layout
  bleed
  title="حاسبة الزكاة: احسب زكاة المال والذهب والنصاب | بيتان"
  description="احسب زكاة مالك بسهولة: النقد والذهب والفضة والأسهم وعروض التجارة، مع حساب النصاب بسعر الذهب أو الفضة اليوم. مجانية ودون تسجيل."
>
  <ToolPage
    heading="حاسبة الزكاة"
    lead="إذا بلغت أموالك النصاب ومرّ عليها عام هجري كامل، فزكاتها 2.5% من قيمتها. والنصاب قيمة 85 غرامًا من الذهب أو 595 غرامًا من الفضة."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <ZakatCalc client:load />

    <Fragment slot="guide">
      <h2>طريقة الحساب</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>اجمع أموالك الزكوية: النقد، والذهب والفضة المدخرة، والأسهم، وعروض التجارة، والديون المرجو تحصيلها.</li>
        <li>اطرح الديون الحالّة عليك.</li>
        <li>قارن الناتج بالنصاب: 85 غرامًا من الذهب عيار 24، أو 595 غرامًا من الفضة.</li>
        <li>إذا بلغ النصاب وحال عليه الحول، فالزكاة 2.5% منه.</li>
      </ol>

      <h2>مثال</h2>
      <p>لديك 60,000 ريال، وسعر غرام الذهب عيار 24 هو 400 ريال. النصاب 85 × 400 = 34,000 ريال، وأموالك تزيد عليه، فالزكاة 60,000 × 2.5% = <strong>1,500 ريال</strong>.</p>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>الذهب أم الفضة؟</h2>
      <p>نصاب الفضة أقل بكثير من نصاب الذهب بالأسعار الحالية، فمن يحسب بالفضة تجب عليه الزكاة في مال أقل. اختر ما يأخذ به أهل العلم الذين تتبعهم.</p>

      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>هل في ذهب الزينة زكاة؟</summary><p>اختلف العلماء في الذهب المعدّ للاستعمال الشخصي. أدخل في الحاسبة الذهب الذي تعتقد وجوب الزكاة فيه.</p></details>
      <details class="bt-faq"><summary>من أين أعرف سعر الذهب اليوم؟</summary><p>من موقع البنك أو محل الذهب الذي تتعامل معه. أدخل سعر الغرام بالعملة نفسها التي أدخلت بها أموالك.</p></details>
      <details class="bt-faq"><summary>هل في الراتب الشهري زكاة؟</summary><p>الزكاة على ما يبقى مدخرًا من الراتب إذا بلغ النصاب وحال عليه الحول، لا على الراتب نفسه.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
