---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import VatCalc from "../components/VatCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="حاسبة ضريبة القيمة المضافة: السعودية 15% والإمارات 5% | بيتان"
  description="أضف ضريبة القيمة المضافة إلى السعر أو استخرجها من مبلغ شامل للضريبة: السعودية 15%، الإمارات 5%، البحرين 10%، عُمان 5%. مجانية ودون تسجيل."
>
  <ToolPage
    heading="حاسبة ضريبة القيمة المضافة"
    lead="لإضافة الضريبة اضرب المبلغ في (1 + النسبة). ولاستخراجها من مبلغ شامل للضريبة اقسم المبلغ على (1 + النسبة)، والفرق هو قيمة الضريبة."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="المصادر"
    sources={[
      { href: "https://zatca.gov.sa/", label: "هيئة الزكاة والضريبة والجمارك (السعودية)" },
      { href: "https://tax.gov.ae/", label: "الهيئة الاتحادية للضرائب (الإمارات)" },
    ]}
  >
    <VatCalc client:load />

    <Fragment slot="guide">
      <h2>نسب ضريبة القيمة المضافة في الخليج</h2>
      <ul>
        <li>السعودية: 15%</li>
        <li>الإمارات: 5%</li>
        <li>البحرين: 10%</li>
        <li>عُمان: 5%</li>
        <li>قطر والكويت: لا تطبقان ضريبة القيمة المضافة حتى الآن.</li>
      </ul>

      <h2>أمثلة</h2>
      <ul>
        <li>سعر 1,000 ريال قبل الضريبة في السعودية: الضريبة 150، والإجمالي <strong>1,150 ريال</strong>.</li>
        <li>فاتورة 1,150 ريال شاملة الضريبة: المبلغ قبل الضريبة 1,150 ÷ 1.15 = 1,000، والضريبة <strong>150 ريال</strong>.</li>
        <li>مبلغ 210 دراهم شامل الضريبة في الإمارات: 210 ÷ 1.05 = 200، والضريبة <strong>10 دراهم</strong>.</li>
      </ul>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>خطأ شائع</h2>
      <p>لا تحسب الضريبة بضرب المبلغ الشامل في 15%. فمن فاتورة 1,150 ريالًا يعطي ذلك 172.50، بينما الضريبة الصحيحة 150 ريالًا. اقسم أولًا على 1.15.</p>

      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>منذ متى أصبحت الضريبة 15% في السعودية؟</summary><p>منذ 1 يوليو 2020، بعد أن كانت 5%. وتطبّق الإمارات 5% منذ 2018، والبحرين 10% منذ يناير 2022، وعُمان 5% منذ أبريل 2021.</p></details>
      <details class="bt-faq"><summary>هل تشمل أسعار المتاجر الضريبة؟</summary><p>في السعودية والإمارات يجب أن تُعرَض الأسعار للمستهلك شاملة الضريبة، فاختر «شامل الضريبة» لمعرفة الضريبة داخل السعر.</p></details>
      <details class="bt-faq"><summary>ماذا تتضمن الفاتورة الضريبية؟</summary><p>المبلغ قبل الضريبة وقيمة الضريبة والإجمالي، مع الرقم الضريبي للبائع. وفي السعودية تحمل الفاتورة الإلكترونية المبسطة رمز QR يمكن مسحه.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
