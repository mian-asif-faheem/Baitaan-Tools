---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import EosCalc from "../components/EosCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  title="حساب مكافأة نهاية الخدمة في الإمارات 2026 | بيتان"
  description="احسب مكافأة نهاية الخدمة في الإمارات وفق قانون العمل الجديد: 21 يومًا عن كل سنة من أول خمس سنوات و30 يومًا بعدها، على الراتب الأساسي. مجاني ودون تسجيل."
>
  <ToolPage
    heading="حساب مكافأة نهاية الخدمة في الإمارات"
    lead="بعد إتمام سنة خدمة، يستحق الموظف أجر 21 يومًا من راتبه الأساسي عن كل سنة من السنوات الخمس الأولى، و30 يومًا عن كل سنة بعدها، بحد أقصى أجر سنتين. ولا تنقص المكافأة عند الاستقالة في القانون الجديد."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="المصادر"
    sources={[{ href: "https://www.mohre.gov.ae/", label: "وزارة الموارد البشرية والتوطين" }]}
  >
    <EosCalc client:load country="ae" />

    <Fragment slot="guide">
      <h2>طريقة الحساب (المادة 51)</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>الأجر اليومي = الراتب الأساسي ÷ 30. وتستخدم بعض الجهات الراتب × 12 ÷ 365.</li>
        <li>عن كل سنة من السنوات الخمس الأولى: 21 يومًا.</li>
        <li>عن كل سنة بعدها: 30 يومًا.</li>
        <li>تُحسب أجزاء السنة بنسبتها، ولا تُحسب أيام الغياب دون أجر.</li>
        <li>لا تزيد المكافأة على أجر سنتين (24 راتبًا أساسيًا).</li>
      </ol>

      <h2>أمثلة براتب أساسي 5,000 درهم</h2>
      <ul>
        <li>3 سنوات و8 أشهر: 77 يومًا × 166.67 = <strong>12,833.33 درهم</strong>.</li>
        <li>6 سنوات و4 أشهر: 105 أيام عن الخمس الأولى و40 يومًا بعدها = <strong>24,166.67 درهم</strong>.</li>
        <li>25 سنة: 117,500 درهم، ولم تبلغ الحد الأقصى (120,000 درهم).</li>
      </ul>

      <AdSlot slot="0000000000" label="إعلان" />

      <h2>أسئلة شائعة</h2>
      <h3 class="font-semibold text-stone-900">هل تقل المكافأة إذا استقلت؟</h3>
      <p>لا. في المرسوم بقانون رقم 33 لسنة 2021 تُحسب المكافأة بالطريقة نفسها سواء استقال الموظف أو أنهى صاحب العمل العقد، ما دام قد أتم سنة خدمة.</p>
      <h3 class="font-semibold text-stone-900">هل يدخل بدل السكن في الحساب؟</h3>
      <p>لا. تُحسب المكافأة على آخر راتب أساسي فقط، دون البدلات أو العمولات.</p>
      <h3 class="font-semibold text-stone-900">متى يجب صرفها؟</h3>
      <p>خلال 14 يومًا من تاريخ انتهاء العلاقة التعاقدية.</p>
      <p>هل تعمل في السعودية؟ استخدم <a class="text-teal-800 underline" href="/nihayat-alkhidma-saudi/">حاسبة نهاية الخدمة في السعودية</a>.</p>
    </Fragment>
  </ToolPage>
</Layout>
