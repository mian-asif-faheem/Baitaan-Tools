---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import HijriAgeCalc from "../components/HijriAgeCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="حساب العمر بالهجري والميلادي | بيتان"
  description="احسب عمرك بالتقويم الهجري والميلادي بالسنوات والأشهر والأيام، واعرف تاريخ ميلادك بالهجري وموعد عيد ميلادك الهجري القادم. مجاني ودون تسجيل."
>
  <ToolPage
    heading="حساب العمر بالهجري"
    lead="أدخل تاريخ ميلادك بالميلادي أو بالهجري لتعرف عمرك بالتقويمين، وتاريخ ميلادك المقابل، وعدد الأيام التي عشتها."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <HijriAgeCalc client:load />

    <Fragment slot="guide">
      <h2>لماذا عمري بالهجري أكبر؟</h2>
      <p>السنة الهجرية أقصر من الميلادية بنحو 11 يومًا، فيزيد العمر بالهجري سنة تقريبًا عن كل 33 سنة ميلادية. فمن عمره 33 سنة ميلادية يكون عمره نحو 34 سنة هجرية.</p>

      <h2>متى يُطلب العمر بالهجري؟</h2>
      <ul>
        <li>في بعض المعاملات الحكومية والنماذج الرسمية في السعودية.</li>
        <li>لحساب سن التكليف والمدد الشرعية.</li>
        <li>لمعرفة تاريخ الميلاد الهجري المسجل في الوثائق القديمة.</li>
      </ul>

      <AdSlot slot="0000000000" label="إعلان" />

      <p>تعتمد الأداة على تقويم أم القرى. وقد يختلف التاريخ الهجري يومًا واحدًا عمّا كان معمولًا به في بلدك يوم ولادتك إذا كان يعتمد رؤية الهلال.</p>
      <p>لحساب المدة بين أي تاريخين استخدم <a class="text-link underline" href="/alfarq-bayna-tarikhayn/">حساب المدة بين تاريخين</a>.</p>
    </Fragment>
  </ToolPage>
</Layout>
