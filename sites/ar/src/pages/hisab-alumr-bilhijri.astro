---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import HijriAgeCalc from "../components/HijriAgeCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="حساب العمر بالهجري والميلادي | بيتان"
  description="احسب عمرك بالتقويم الهجري والميلادي بالسنوات والأشهر والأيام، واعرف تاريخ ميلادك بالهجري وموعد عيد ميلادك الهجري القادم. مجاني ودون تسجيل."
>
  <ToolPage
    heading="حساب العمر بالهجري"
    lead="أدخل تاريخ ميلادك بالميلادي أو بالهجري لتعرف عمرك بالتقويمين، وتاريخ ميلادك المقابل، وعدد الأيام التي عشتها."
    updated="آخر تحديث: نوفمبر 2026"
    sourcesHeading="المصادر"
    sources={[{ href: "https://www.ummulqura.org.sa/", label: "تقويم أم القرى" }]}
  >
    <HijriAgeCalc client:load />

    <Fragment slot="guide">
      <h2>لماذا عمري بالهجري أكبر؟</h2>
      <p>السنة الهجرية أقصر من الميلادية بنحو 11 يومًا، فيزيد العمر بالهجري سنة تقريبًا عن كل 33 سنة ميلادية. فمن عمره 33 سنة ميلادية يكون عمره نحو 34 سنة هجرية.</p>

      <h2>متى يُطلب العمر بالهجري؟</h2>
      <ul>
        <li>في بعض المعاملات الحكومية والنماذج الرسمية في السعودية.</li>
        <li>لحساب سن التكليف والمدد الشرعية.</li>
        <li>لمعرفة تاريخ الميلاد الهجري المسجل في الوثائق القديمة.</li>
      </ul>

      <AdSlot unit="0000000000" label="إعلان" />

      <p>تعتمد الأداة على تقويم أم القرى. وقد يختلف التاريخ الهجري يومًا واحدًا عمّا كان مطبّقًا في بلدك يوم ولادتك إذا كان يعتمد رؤية الهلال.</p>
      <p>يمكن حساب المدة بين أي تاريخين باستخدام <a class="text-link underline" href="/alfarq-bayna-tarikhayn/">حاسبة المدة بين تاريخين</a>.</p>

      <h2>مثال</h2>
      <p>من وُلد في 1 يناير 1993 يوافق تاريخ ميلاده 8 رجب 1413 هـ. وفي 1 ديسمبر 2026 يكون عمره:</p>
      <ul class="ms-5 list-disc space-y-1">
        <li><strong>بالميلادي:</strong> 33 سنة و11 شهرًا.</li>
        <li><strong>بالهجري:</strong> 34 سنة و11 شهرًا و13 يومًا.</li>
      </ul>
      <p>الفرق سنة هجرية كاملة تقريبًا، لأن 34 سنة هجرية أقصر من 34 سنة ميلادية بنحو سنة.</p>
      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>لماذا عمري بالهجري أكبر من الميلادي؟</summary><p>لأن السنة الهجرية أقصر بنحو 11 يومًا، فتكتمل السنوات الهجرية أسرع، ويزيد العمر بالهجري سنة تقريبًا كل 33 سنة.</p></details>
      <details class="bt-faq"><summary>بأي تقويم تُكتب التواريخ في الوثائق السعودية؟</summary><p>تعتمد الجهات الحكومية في السعودية تقويم أم القرى في التاريخ الهجري، وتستخدم كثير من الوثائق الحديثة التاريخين معًا.</p></details>
      <details class="bt-faq"><summary>هل قد يختلف تاريخ ميلادي الهجري يومًا؟</summary><p>نعم. إذا كانت بداية الشهر في بلدك يوم ولادتك تعتمد رؤية الهلال، فقد يختلف يومًا عن تقويم أم القرى. اعتمد التاريخ المكتوب في وثائقك الرسمية.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
