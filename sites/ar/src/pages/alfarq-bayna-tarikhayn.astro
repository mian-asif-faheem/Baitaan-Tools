---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import DateDiffCalc from "../components/DateDiffCalc.tsx";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="حساب المدة بين تاريخين بالهجري والميلادي | بيتان"
  description="احسب عدد الأيام والأسابيع والأشهر والسنوات بين تاريخين، بالتقويم الهجري أو الميلادي، مع أيام العمل دون عطلة نهاية الأسبوع. مجاني ودون تسجيل."
>
  <ToolPage
    heading="حساب المدة بين تاريخين"
    lead="أدخل التاريخين بالهجري أو بالميلادي لتعرف عدد الأيام بينهما، والمدة بالسنوات والأشهر والأيام في التقويمين، وعدد أيام العمل."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <DateDiffCalc client:load />

    <Fragment slot="guide">
      <h2>استخدامات شائعة</h2>
      <ul>
        <li>حساب مدة العقود والإجازات وفترات التجربة.</li>
        <li>معرفة الأيام المتبقية على موعد رسمي أو انتهاء إقامة أو جواز.</li>
        <li>حساب العِدّة والمدد الشرعية بالتقويم الهجري.</li>
      </ul>

      <h2>لماذا يختلف الحساب الهجري عن الميلادي؟</h2>
      <p>الشهر الهجري 29 أو 30 يومًا، والسنة الهجرية نحو 354 يومًا. لذلك قد تكون المدة نفسها «سنة واحدة» بالهجري و«11 شهرًا و20 يومًا» بالميلادي.</p>

      <AdSlot unit="0000000000" label="إعلان" />

      <h2>أيام العمل</h2>
      <p>تحسب الأداة أيام العمل بعد استبعاد الجمعة والسبت، وهي عطلة نهاية الأسبوع في السعودية ومعظم دول الخليج. وفي الإمارات اختر السبت والأحد. ولا تستبعد الأداة الإجازات الرسمية، فاطرحها يدويًا عند الحاجة.</p>
      <p>تريد عمرك بالهجري؟ استخدم <a class="text-link underline" href="/hisab-alumr-bilhijri/">حساب العمر بالهجري</a>.</p>
    </Fragment>
  </ToolPage>
</Layout>
