---
import Layout from "../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import MergePdfTool from "@bt/ui/MergePdfTool.tsx";
import t from "../i18n/ar.json";
---
<!-- TODO (native review): Arabic copy. -->
<Layout
  bleed
  title="دمج ملفات PDF والصور في ملف واحد مجانًا | بيتان"
  description="ادمج عدة ملفات PDF وصور JPG وPNG في ملف PDF واحد بالترتيب الذي تريده، دون رفع مستنداتك. مجاني ودون تسجيل."
>
  <ToolPage
    heading="دمج ملفات PDF"
    lead="اختر الملفات والصور، ورتّبها كما تريد، ونزّلها في ملف PDF واحد. مستنداتك لا تغادر جهازك."
    updated="آخر تحديث: نوفمبر 2026"
  >
    <MergePdfTool client:visible t={t.merge} outputName="documents.pdf" locale="ar-SA-u-nu-latn" />

    <Fragment slot="guide">
      <h2>متى تحتاجها؟</h2>
      <p>تطلب منصات التقديم غالبًا رفع المستندات في ملف واحد: الهوية والجواز والشهادات وخطاب التعريف.</p>

      <h2>طريقة الاستخدام</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>اختر الملفات. تصبح كل صورة JPG أو PNG صفحة A4.</li>
        <li>استخدم الأسهم لتغيير الترتيب.</li>
        <li>اضغط «دمج الملفات» ثم نزّل الملف.</li>
        <li>إذا كان الحجم كبيرًا فاستخدم <a class="text-link underline" href="/dagt-pdf/">ضغط PDF</a>.</li>
      </ol>

      <AdSlot unit="0000000000" label="إعلان" />

      <p>ينسخ الدمج الصفحات كما هي دون أي فقد في الجودة، ويبقى النص قابلًا للتحديد. ولا تعمل الأداة مع الملفات المحمية بكلمة مرور.</p>

      <h2>أسئلة شائعة</h2>
      <details class="bt-faq"><summary>هل يمكن دمج الصور مع ملفات PDF في ملف واحد؟</summary><p>نعم. تتحول كل صورة JPG أو PNG إلى صفحة بحجم A4، بالترتيب الذي تحدده بالأسهم.</p></details>
      <details class="bt-faq"><summary>هل يوجد حد لعدد الملفات؟</summary><p>لا يوجد حد ثابت، فالأمر يعتمد على ذاكرة جهازك. وقد تتأخر الملفات الكبيرة جدًا على الجوالات القديمة، فادمجها على دفعتين عند الحاجة.</p></details>
      <details class="bt-faq"><summary>هل تُرسَل مستنداتي إلى أي مكان؟</summary><p>لا. تجري العملية كلها على جهازك، ولا يُرسَل شيء إلى خوادمنا.</p></details>
      <details class="bt-faq"><summary>هل تعمل مع ملفات PDF المحمية بكلمة مرور؟</summary><p>ليس دائمًا: قد يفشل الملف المحمي أو تظهر صفحاته فارغة. أزل كلمة المرور أولًا من التطبيق الذي أُنشئ فيه الملف.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
