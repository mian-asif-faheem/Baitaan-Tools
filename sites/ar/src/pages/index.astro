---
import Layout from "../components/Layout.astro";

const groups = [
  {
    title: "التاريخ الهجري والمناسبات",
    tools: [
      { href: "/tahweel-altareekh/", name: "تحويل التاريخ", desc: "من ميلادي إلى هجري وبالعكس، حسب أم القرى" },
      { href: "/kam-baqi-ala-ramadan/", name: "كم باقي على رمضان", desc: "عد تنازلي بالأيام والساعات" },
      { href: "/kam-baqi-ala-eid-alfitr/", name: "كم باقي على عيد الفطر", desc: "" },
      { href: "/kam-baqi-ala-eid-aladha/", name: "كم باقي على عيد الأضحى", desc: "مع موعد يوم عرفة" },
      { href: "/hisab-alumr-bilhijri/", name: "حساب العمر بالهجري", desc: "عمرك بالتقويمين" },
      { href: "/alfarq-bayna-tarikhayn/", name: "المدة بين تاريخين", desc: "بالأيام والأشهر وأيام العمل" },
    ],
  },
  {
    title: "العمل والمال",
    tools: [
      { href: "/nihayat-alkhidma-saudi/", name: "مكافأة نهاية الخدمة · السعودية", desc: "عند الاستقالة أو إنهاء العقد" },
      { href: "/nihayat-alkhidma-uae/", name: "مكافأة نهاية الخدمة · الإمارات", desc: "وفق قانون العمل الجديد" },
      { href: "/hasibat-addariba/", name: "ضريبة القيمة المضافة", desc: "إضافة الضريبة أو استخراجها" },
      { href: "/hasibat-azzakat/", name: "حاسبة الزكاة", desc: "مع النصاب بسعر الذهب أو الفضة" },
    ],
  },
  {
    title: "المستندات والنصوص",
    tools: [
      { href: "/maqas-assura/", name: "مقاس الصورة للطباعة", desc: "4×6 و3.5×4.5 وغيرها" },
      { href: "/dagt-pdf/", name: "ضغط PDF", desc: "إلى 1 ميغا أو أقل" },
      { href: "/damj-pdf/", name: "دمج PDF", desc: "ملفات وصور في ملف واحد" },
      { href: "/adad-alkalimat/", name: "عداد الكلمات", desc: "مع عدّ التشكيل وإزالته" },
    ],
  },
];
---
<!-- TODO (native review): all Arabic copy on this site. -->
<Layout title="أدوات مجانية بالعربية | بيتان" description="أدوات وحاسبات مجانية تعمل في متصفحك دون تسجيل: تحويل التاريخ الهجري، كم باقي على رمضان، مكافأة نهاية الخدمة، الضريبة، الزكاة، ضغط PDF.">
  <h1 class="text-3xl font-bold">أدوات مجانية دون تسجيل</h1>
  <p class="mt-3 text-lg text-stone-600">حاسبات وأدوات تعمل في متصفحك. بياناتك لا تغادر جهازك.</p>
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a href={tool.href} class="block h-full rounded-xl border border-stone-200 bg-white p-5 shadow-sm hover:border-teal-700">
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
