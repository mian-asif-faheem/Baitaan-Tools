---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../components/Layout.astro";
import { toHijri, HIJRI_MONTHS_AR } from "@bt/tools/hijri";

// Today's Hijri date as of the build; the script below refreshes it in the browser.
const h = toHijri(new Date());
const today = `${h.day} ${HIJRI_MONTHS_AR[h.month - 1]} ${h.year}\u00a0هـ`;

const groups: Group[] = [
  {
    title: "التاريخ الهجري والمناسبات",
    featured: {
      href: "/tahweel-altareekh/",
      name: "تحويل التاريخ",
      desc: "من ميلادي إلى هجري وبالعكس، حسب أم القرى",
      exampleLabel: "اليوم",
      example: today,
      exampleId: "bt-today"
    },
    tools: [
      {
        href: "/kam-baqi-ala-ramadan/",
        name: "كم باقي على رمضان",
        desc: "عد تنازلي بالأيام والساعات"
      },
      {
        href: "/kam-baqi-ala-eid-alfitr/",
        name: "كم باقي على عيد الفطر"
      },
      {
        href: "/kam-baqi-ala-eid-aladha/",
        name: "كم باقي على عيد الأضحى",
        desc: "مع موعد يوم عرفة"
      },
      {
        href: "/hisab-alumr-bilhijri/",
        name: "حساب العمر بالهجري",
        desc: "عمرك بالتقويمين"
      },
      {
        href: "/alfarq-bayna-tarikhayn/",
        name: "المدة بين تاريخين",
        desc: "بالأيام والأشهر وأيام العمل"
      }
    ]
  },
  {
    title: "العمل والمال",
    tools: [
      {
        href: "/nihayat-alkhidma-saudi/",
        name: "مكافأة نهاية الخدمة · السعودية",
        desc: "عند الاستقالة أو إنهاء العقد"
      },
      {
        href: "/nihayat-alkhidma-uae/",
        name: "مكافأة نهاية الخدمة · الإمارات",
        desc: "وفق قانون العمل الجديد"
      },
      {
        href: "/hasibat-addariba/",
        name: "ضريبة القيمة المضافة",
        desc: "إضافة الضريبة أو استخراجها"
      },
      {
        href: "/hasibat-azzakat/",
        name: "حاسبة الزكاة",
        desc: "مع النصاب بسعر الذهب أو الفضة"
      }
    ]
  },
  {
    title: "المستندات والنصوص",
    tools: [
      {
        href: "/maqas-assura/",
        name: "مقاس الصورة للطباعة",
        desc: "4×6 و3.5×4.5 وغيرها"
      },
      {
        href: "/dagt-pdf/",
        name: "ضغط PDF",
        desc: "إلى 1 ميغا أو أقل"
      },
      {
        href: "/damj-pdf/",
        name: "دمج PDF",
        desc: "ملفات وصور في ملف واحد"
      },
      {
        href: "/adad-alkalimat/",
        name: "عداد الكلمات",
        desc: "مع عدّ التشكيل وإزالته"
      }
    ]
  }
];
---
<Layout bleed wide title="أدوات مجانية بالعربية | بيتان" description="أدوات وحاسبات مجانية تعمل في متصفحك دون تسجيل: تحويل التاريخ الهجري، كم باقي على رمضان، مكافأة نهاية الخدمة، الضريبة، الزكاة، ضغط PDF.">
  <Hero title="أدوات مجانية دون تسجيل" lead="حاسبات وأدوات تعمل في متصفحك. بياناتك لا تغادر جهازك." cta={{ href: "/tahweel-altareekh/", label: "حوّل التاريخ الآن" }} />
  <ToolGrid {groups} />
</Layout>

<script>
  import { toHijri, HIJRI_MONTHS_AR } from "@bt/tools/hijri";
  const el = document.getElementById("bt-today");
  const h = toHijri(new Date());
  if (el) el.textContent = `${h.day} ${HIJRI_MONTHS_AR[h.month - 1]} ${h.year}\u00a0هـ`;
</script>
