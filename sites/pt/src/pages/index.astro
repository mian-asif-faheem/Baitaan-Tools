---
import Layout from "../components/Layout.astro";

const tools = [
  { href: "/calculadora-salario-liquido/", name: "Calculadora de salário líquido 2026", desc: "CLT · INSS, IRRF e a isenção até R$ 5 mil", ready: true },
  { href: "#", name: "Calculadora de horas extras e adicional noturno", desc: "", ready: false },
  { href: "#", name: "Calculadora de férias", desc: "", ready: false },
  { href: "#", name: "Calculadora de 13º salário", desc: "", ready: false },
];
---
<Layout title="Ferramentas grátis em português | Baitaan" description="Calculadoras trabalhistas e ferramentas gratuitas que rodam no seu navegador, sem cadastro.">
  <h1 class="text-3xl font-bold tracking-tight">Ferramentas grátis, sem cadastro</h1>
  <p class="mt-3 text-lg text-stone-600">Calculadoras trabalhistas e utilidades que rodam no seu navegador. Seus dados não saem do seu aparelho.</p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {tools.map((tool) => (
      <li>
        <a href={tool.href} class={`block rounded-xl border bg-white p-5 shadow-sm ${tool.ready ? "border-stone-200 hover:border-teal-700" : "pointer-events-none border-dashed border-stone-300 opacity-60"}`}>
          <span class="block font-semibold">{tool.name}</span>
          <span class="mt-1 block text-sm text-stone-500">{tool.ready ? tool.desc : "Em breve"}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
