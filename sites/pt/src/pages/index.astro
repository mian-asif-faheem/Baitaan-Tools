---
import Layout from "../components/Layout.astro";

const groups = [
  {
    title: "Calculadoras trabalhistas",
    tools: [
      { href: "/calculadora-rescisao/", name: "Rescisão trabalhista", desc: "Sem justa causa, pedido, acordo ou justa causa" },
      { href: "/calculadora-salario-liquido/", name: "Salário líquido 2026", desc: "INSS, IRRF e a isenção até R$ 5 mil" },
      { href: "/calculadora-ferias/", name: "Férias", desc: "1/3, venda de 10 dias e valor líquido" },
      { href: "/calculadora-13-salario/", name: "13º salário", desc: "1ª e 2ª parcela com descontos" },
      { href: "/calculadora-horas-extras/", name: "Horas extras e adicional noturno", desc: "50%, 100%, hora reduzida e DSR" },
      { href: "/calculadora-salario-proporcional/", name: "Salário proporcional", desc: "Dias trabalhados e desconto de faltas" },
    ],
  },
  {
    title: "Documentos",
    tools: [
      { href: "/foto-3x4/", name: "Foto 3x4", desc: "Recorte e imprima em folha 10x15 ou A4" },
      { href: "/comprimir-pdf/", name: "Comprimir PDF para 1 MB", desc: "Para sites que limitam o tamanho" },
      { href: "/juntar-pdf/", name: "Juntar PDF", desc: "Una PDFs e fotos num arquivo só" },
    ],
  },
  {
    title: "Em breve",
    soon: true,
    tools: [
      { href: "#", name: "CLT x PJ", desc: "Compare salário e impostos" },
      { href: "#", name: "Banco de horas", desc: "" },
    ],
  },
];
---
<Layout title="Ferramentas grátis em português | Baitaan" description="Calculadoras trabalhistas e ferramentas gratuitas que rodam no seu navegador, sem cadastro: rescisão, férias, 13º, horas extras, foto 3x4 e PDF.">
  <h1 class="text-3xl font-bold tracking-tight">Ferramentas grátis, sem cadastro</h1>
  <p class="mt-3 text-lg text-stone-600">Calculadoras trabalhistas e utilidades que rodam no seu navegador. Seus dados não saem do seu aparelho.</p>
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class={`block h-full rounded-xl border bg-white p-5 shadow-sm ${g.soon ? "pointer-events-none border-dashed border-stone-300 opacity-60" : "border-stone-200 hover:border-teal-700"}`}
            >
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
