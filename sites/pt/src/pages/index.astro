---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../components/Layout.astro";
import HomeExtras from "../components/HomeExtras.astro";
import PhoneShot from "@bt/ui/sections/PhoneShot.astro";

const groups: Group[] = [
  {
    title: "Calculadoras trabalhistas",
    featured: {
      href: "/calculadora-rescisao/",
      name: "Rescisão trabalhista",
      desc: "Sem justa causa, pedido, acordo ou justa causa",
      exampleLabel: "Exemplo · demissão sem justa causa, R$ 3.000",
      example: "R$ 13.392,64"
    },
    tools: [
      {
        href: "/calculadora-salario-liquido/",
        name: "Salário líquido 2026",
        desc: "INSS, IRRF e a isenção até R$ 5 mil"
      },
      {
        href: "/calculadora-ferias/",
        name: "Férias",
        desc: "1/3, venda de 10 dias e valor líquido"
      },
      {
        href: "/calculadora-13-salario/",
        name: "13º salário",
        desc: "1ª e 2ª parcela com descontos"
      },
      {
        href: "/calculadora-horas-extras/",
        name: "Horas extras e adicional noturno",
        desc: "50%, 100%, hora reduzida e DSR"
      },
      {
        href: "/calculadora-salario-proporcional/",
        name: "Salário proporcional",
        desc: "Dias trabalhados e desconto de faltas"
      }
    ]
  },
  {
    title: "Documentos",
    tools: [
      {
        href: "/foto-3x4/",
        name: "Foto 3x4",
        desc: "Recorte e imprima em folha 10x15 ou A4"
      },
      {
        href: "/comprimir-pdf/",
        name: "Comprimir PDF para 1 MB",
        desc: "Para sites que limitam o tamanho"
      },
      {
        href: "/juntar-pdf/",
        name: "Juntar PDF",
        desc: "Una PDFs e fotos num arquivo só"
      }
    ]
  }
];
---
<Layout bleed wide title="Ferramentas grátis em português | Baitaan" description="Calculadoras trabalhistas e ferramentas gratuitas que rodam no seu navegador, sem cadastro: rescisão, férias, 13º, horas extras, foto 3x4 e PDF.">
  <Hero title="Ferramentas grátis, sem cadastro" lead="Calculadoras trabalhistas e utilidades que rodam no seu navegador. Seus dados não saem do seu aparelho." cta={{ href: "/calculadora-rescisao/", label: "Calcular rescisão" }}>
    <PhoneShot slot="visual" title="Calculadora de rescisão" label="Líquido a receber · sem justa causa" value="R$ 13.392,64" rows={[["Saldo de salário", "R$ 1.500,00"], ["Aviso prévio", "R$ 3.600,00"], ["Férias + 1/3", "R$ 6.333,33"]]} />
  </Hero>
  <HomeExtras lang="pt" part="top" />
  <ToolGrid {groups} />
  <HomeExtras lang="pt" part="bottom" />
</Layout>
