---
import Hero from "@bt/ui/Hero.astro";
import Layout from "../../components/Layout.astro";

const groups = [
  {
    title: "Employment calculators",
    tools: [
      { href: "/en/calculadora-rescisao/", name: "Termination pay (rescisão)", desc: "Dismissal, resignation, agreement or just cause" },
      { href: "/en/calculadora-salario-liquido/", name: "Net salary 2026", desc: "INSS, income tax and the R$ 5,000 exemption" },
      { href: "/en/calculadora-ferias/", name: "Vacation pay (férias)", desc: "1/3 bonus, selling 10 days and net amount" },
      { href: "/en/calculadora-13-salario/", name: "13th salary", desc: "1st and 2nd installment with deductions" },
      { href: "/en/calculadora-horas-extras/", name: "Overtime and night premium", desc: "50%, 100%, short night hour and DSR" },
      { href: "/en/calculadora-salario-proporcional/", name: "Proportional salary", desc: "Days worked and absence deductions" },
    ],
  },
  {
    title: "Documents",
    tools: [
      { href: "/en/foto-3x4/", name: "3x4 photo", desc: "Crop and print on a 10x15 or A4 sheet" },
      { href: "/en/comprimir-pdf/", name: "Compress PDF to 1 MB", desc: "For sites that limit file size" },
      { href: "/en/juntar-pdf/", name: "Merge PDF", desc: "Combine PDFs and photos into one file" },
    ],
  },
  {
    title: "Coming soon",
    soon: true,
    tools: [
      { href: "#", name: "CLT vs PJ", desc: "Compare salary and taxes" },
      { href: "#", name: "Hour bank", desc: "" },
    ],
  },
];
---
<Layout lang="en" title="Free tools for Brazil, in English | Baitaan" description="Free Brazilian employment calculators and tools that run in your browser, no sign-up: termination, vacation, 13th salary, overtime, 3x4 photo and PDF.">
  <Hero title="Free tools for Brazil, no sign-up" lead="Employment calculators under Brazilian law (CLT) and handy utilities that run in your browser. Your data never leaves your device." />
  {groups.map((g) => (
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">{g.title}</h2>
      <ul class="mt-3 grid gap-4 sm:grid-cols-2">
        {g.tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class={`block h-full rounded-xl border bg-white p-5 shadow-sm ${g.soon ? "pointer-events-none border-dashed border-stone-300 opacity-60" : "relative isolate overflow-hidden border-stone-200 hover:border-teal-700"}`}
              data-spotlight={g.soon ? undefined : ""}
            >
              <span class="block font-semibold">{tool.name}</span>
              {tool.desc && <span class="mt-1 block text-sm text-stone-500">{tool.desc}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  import { spotlightAll } from "@bt/ui/fx/spotlight";
  spotlightAll();
</script>
