---
import Hero from "@bt/ui/Hero.astro";
import ToolGrid, { type Group } from "@bt/ui/ToolGrid.astro";
import Layout from "../../components/Layout.astro";

const groups: Group[] = [
  {
    title: "Employment calculators",
    featured: {
      href: "/en/calculadora-rescisao/",
      name: "Termination pay (rescisão)",
      desc: "Dismissal, resignation, agreement or just cause",
      exampleLabel: "Example · dismissal, R$ 3,000 a month",
      example: "R$ 13,392.64"
    },
    tools: [
      {
        href: "/en/calculadora-salario-liquido/",
        name: "Net salary 2026",
        desc: "INSS, income tax and the R$ 5,000 exemption"
      },
      {
        href: "/en/calculadora-ferias/",
        name: "Vacation pay (férias)",
        desc: "1/3 bonus, selling 10 days and net amount"
      },
      {
        href: "/en/calculadora-13-salario/",
        name: "13th salary",
        desc: "1st and 2nd installment with deductions"
      },
      {
        href: "/en/calculadora-horas-extras/",
        name: "Overtime and night premium",
        desc: "50%, 100%, short night hour and DSR"
      },
      {
        href: "/en/calculadora-salario-proporcional/",
        name: "Proportional salary",
        desc: "Days worked and absence deductions"
      }
    ]
  },
  {
    title: "Documents",
    tools: [
      {
        href: "/en/foto-3x4/",
        name: "3x4 photo",
        desc: "Crop and print on a 10x15 or A4 sheet"
      },
      {
        href: "/en/comprimir-pdf/",
        name: "Compress PDF to 1 MB",
        desc: "For sites that limit file size"
      },
      {
        href: "/en/juntar-pdf/",
        name: "Merge PDF",
        desc: "Combine PDFs and photos into one file"
      }
    ]
  },
  {
    title: "Coming soon",
    soon: true,
    tools: [
      {
        href: "#",
        name: "CLT vs PJ",
        desc: "Compare salary and taxes"
      },
      {
        href: "#",
        name: "Hour bank"
      }
    ]
  }
];
---
<Layout bleed wide lang="en" title="Free tools for Brazil, in English | Baitaan" description="Free Brazilian employment calculators and tools that run in your browser, no sign-up: termination, vacation, 13th salary, overtime, 3x4 photo and PDF.">
  <Hero title="Free tools for Brazil, no sign-up" lead="Employment calculators under Brazilian law (CLT) and handy utilities that run in your browser. Your data never leaves your device." cta={{ href: "/en/calculadora-rescisao/", label: "Calculate termination pay" }} />
  <ToolGrid {groups} />
</Layout>
