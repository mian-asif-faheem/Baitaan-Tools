---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import FeriasCalc from "../../components/FeriasCalc.tsx";
---
<Layout
  bleed
  lang="en"
  title="Brazil vacation pay calculator 2026 (CLT): 1/3 bonus and net | Baitaan"
  description="Work out your 2026 vacation pay in Brazil: gross amount, the constitutional 1/3 bonus, selling 10 days (abono pecuniário), INSS, income tax with the 2026 reduction, and net pay. Free, no sign-up."
>
  <ToolPage
    heading="Vacation pay calculator 2026 (Brazil)"
    lead="On vacation (férias) you get the salary for your days off plus a 1/3 bonus. If you sell 10 days, you also get the abono pecuniário, which has no INSS or income tax."
    updated="Updated: November 2026 · 2026 INSS and income tax tables"
    sourcesHeading="Sources"
    sources={[
      { href: "https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452.htm", label: "CLT, arts. 129 to 145" },
      { href: "https://www.planalto.gov.br/ccivil_03/_ato2023-2026/2025/lei/L15270.htm", label: "Law 15.270/2025 (income tax reduction)" },
    ]}
  >
    <FeriasCalc client:load lang="en" />

    <Fragment slot="guide">
      <h2>How to calculate vacation pay</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>Divide the salary (plus the average overtime and allowances) by 30 and multiply by your days off.</li>
        <li>Add 1/3 of that amount.</li>
        <li>If you sell days, calculate the abono the same way, also with 1/3.</li>
        <li>Take off INSS and income tax on the vacation pay and its 1/3. The abono and its 1/3 are exempt.</li>
      </ol>

      <h2>2026 examples</h2>
      <ul>
        <li>Salary of R$ 3,000, 30 days: R$ 3,000 + R$ 1,000 bonus = R$ 4,000. INSS of R$ 368.60; income tax is zero thanks to the 2026 reduction. <strong>Net: R$ 3,631.40.</strong></li>
        <li>Salary of R$ 6,000, selling 10 days: 20 days off (R$ 4,000 + R$ 1,333.33) and a 10-day abono (R$ 2,000 + R$ 666.67). INSS of R$ 548.18 and income tax of R$ 122.45. <strong>Net: R$ 7,329.37.</strong></li>
      </ul>

      <h2>Absences reduce your vacation days</h2>
      <p>Unexcused absences in the 12-month accrual period shorten your vacation (CLT art. 130):</p>
      <ul>
        <li>Up to 5 absences: 30 days</li>
        <li>6 to 14: 24 days</li>
        <li>15 to 23: 18 days</li>
        <li>24 to 32: 12 days</li>
        <li>More than 32: no vacation for that period</li>
      </ul>

      <AdSlot unit="0000000000" label="Advertisement" />

      <h2>Frequently asked questions</h2>
      <details class="bt-faq"><summary>When must the employer pay?</summary><p>Up to 2 days before your vacation starts (art. 145).</p></details>
      <details class="bt-faq"><summary>Can I split my vacation?</summary><p>Yes, into up to 3 periods if you agree. One must be at least 14 days, and the others at least 5 days each (art. 134).</p></details>
      <details class="bt-faq"><summary>Does the 2026 income tax reduction apply to vacation pay?</summary><p>Law 15.270/2025 doesn't mention vacation pay explicitly. Most payroll systems apply the reduction, so the calculator does too. Untick the option to see the amount without it.</p></details>
    </Fragment>
  </ToolPage>
</Layout>
