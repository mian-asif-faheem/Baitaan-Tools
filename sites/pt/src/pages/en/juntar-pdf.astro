---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import MergePdfTool from "@bt/ui/MergePdfTool.tsx";
import t from "../../i18n/en.json";
---
<Layout
  lang="en"
  title="Merge PDF for free: combine PDFs and photos into one file | Baitaan"
  description="Combine several PDFs and photos (JPG and PNG) into one file, in the order you want. Ideal for RG, CPF and proof of address. Free, and your documents are never uploaded."
>
  <ToolPage
    heading="Merge PDF"
    lead="Choose your PDFs and photos, put them in the right order and download everything as one PDF. Your documents never leave your device."
    updated="Updated: November 2026"
  >
    <MergePdfTool client:visible t={t.merge} outputName="documents.pdf" locale="en-US" />

    <Fragment slot="guide">
      <h2>When to use it</h2>
      <p>Many sites ask for all your documents in a single file: RG, CPF, proof of address and diploma for enrolment, applications or starting a job.</p>

      <h2>How to use it</h2>
      <ol class="ms-5 list-decimal space-y-1">
        <li>Tap “Choose the PDFs” and select the files. Each JPG or PNG photo becomes an A4 page.</li>
        <li>Use the arrows to change the order.</li>
        <li>Tap “Merge PDFs” and download the file.</li>
        <li>If the site has a size limit, run the result through <a class="text-teal-800 underline" href="/en/comprimir-pdf/">compress PDF</a>.</li>
      </ol>

      <AdSlot slot="0000000000" label="Advertisement" />

      <h2>Frequently asked questions</h2>
      <h3 class="font-semibold text-stone-900">Can the text still be selected?</h3>
      <p>Yes. When merging, the pages are copied as they are, with no loss of quality.</p>
      <h3 class="font-semibold text-stone-900">Does it work with password-protected PDFs?</h3>
      <p>No. Remove the password first, in the app the PDF was created with.</p>
    </Fragment>
  </ToolPage>
</Layout>
