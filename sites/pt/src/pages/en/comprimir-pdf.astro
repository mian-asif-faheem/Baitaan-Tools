---
import Layout from "../../components/Layout.astro";
import ToolPage from "@bt/ui/ToolPage.astro";
import AdSlot from "@bt/ui/AdSlot.astro";
import PdfCompressTool from "@bt/ui/PdfCompressTool.tsx";
import t from "../../i18n/en.json";
---
<Layout
  lang="en"
  title="Compress PDF to 1 MB or 2 MB for free, without uploading | Baitaan"
  description="Shrink a PDF to 1 MB, 2 MB or whatever limit a site asks for: Enem, university entrance, public exams, gov.br and job applications. Works in your browser."
>
  <ToolPage
    heading="Compress PDF to 1 MB"
    lead="Choose your PDF and the maximum size the site asks for. The tool shrinks the file in your browser, without sending it to any server."
    updated="Updated: November 2026"
  >
    <PdfCompressTool client:visible t={t.pdf} targets={[0.5, 1, 2, 5]} defaultTarget={1} locale="en-US" />

    <Fragment slot="guide">
      <h2>What it's for</h2>
      <p>Applications for public exams, university entrance, scholarships, jobs and government services often limit files to 1 MB or 2 MB. Documents scanned with a phone are almost always bigger.</p>

      <h2>How it works</h2>
      <p>Each page becomes a good-quality JPG image and a new PDF is built. The tool starts at the highest quality and steps down until it reaches the size you chose.</p>
      <p>It works best with scanned documents, photos of your RG or CNH, and receipts. In a PDF with digital text, the text can no longer be selected afterwards.</p>

      <AdSlot slot="0000000000" label="Advertisement" />

      <h2>Tips</h2>
      <ul>
        <li>If the file has many pages, send only the ones requested.</li>
        <li>To put your RG, CPF and proof of address in one file, use <a class="text-teal-800 underline" href="/en/juntar-pdf/">merge PDF</a> first, then compress.</li>
        <li>Open the compressed PDF before sending it and check that numbers and signatures are readable.</li>
      </ul>

      <h2>Is it safe?</h2>
      <p>Yes. The PDF is processed on your device and isn't sent to our servers. To check: choose the file, turn off the internet and tap “Compress”. The tool keeps working.</p>
    </Fragment>
  </ToolPage>
</Layout>
