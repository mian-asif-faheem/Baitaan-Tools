---
/**
 * Standard tool page: heading + short answer, the tool, then the guide.
 * Pass the tool as the default slot and the guide as slot="guide".
 */
interface Props {
  heading: string;
  lead: string;
  updated: string; // shown to users: "Actualizado: noviembre 2026"
  sources?: { href: string; label: string }[];
  sourcesHeading?: string;
}
const { heading, lead, updated, sources = [], sourcesHeading = "Fuentes" } = Astro.props;
---
<article>
  <h1 class="text-3xl font-bold tracking-tight text-stone-900">{heading}</h1>
  <p class="mt-3 text-lg text-stone-600">{lead}</p>
  <p class="mt-1 text-xs text-stone-400">{updated}</p>

  <section class="mt-6 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
    <slot />
  </section>

  <div class="guide mt-10 space-y-4 leading-relaxed text-stone-700 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-stone-900 [&_li]:ms-5 [&_li]:list-disc">
    <slot name="guide" />
  </div>

  {sources.length > 0 && (
    <section class="mt-10 border-t border-stone-200 pt-4 text-sm">
      <h2 class="font-semibold text-stone-900">{sourcesHeading}</h2>
      <ul class="mt-2 space-y-1">
        {sources.map((s) => <li><a class="text-teal-800 underline" href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </section>
  )}
</article>
