---
/**
 * Standard tool page (Claude Design board 3): breadcrumb, heading, lead and trust chips over a
 * soft glow; then the tool, the guide (slot="guide") and the sources card.
 * FAQ entries in the guide are <details class="bt-faq"><summary>…</summary><p>…</p></details>.
 * A heading followed by FAQ entries becomes one FAQ block (layout after React Bits Pro "FAQ 5",
 * rebuilt in this project's own styles): centred heading, a "write to us" line, question cards.
 */
import Icon from "./Icon.astro";
import * as I from "./icons";
import { shell } from "./shell";
import AdSlot from "./AdSlot.astro";

interface Props {
  heading: string;
  lead: string;
  updated: string; // shown to users: "Actualizado: noviembre 2026"
  sources?: { href: string; label: string }[];
  sourcesHeading?: string;
}
const { heading, lead, updated, sources = [], sourcesHeading = "Fuentes" } = Astro.props;
const guideHtml = Astro.slots.has("guide") ? await Astro.slots.render("guide") : "";
const { chrome, nav, homeHref, contact } = shell(Astro.locals);
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
const faqHead = (h: string) =>
  `<header class="bt-faqs__head"><h2>${h}</h2>` +
  (chrome.faqMore && chrome.faqAsk && contact
    ? `<p>${esc(chrome.faqMore)} <a href="${esc(contact)}">${esc(chrome.faqAsk)}<span class="bt-faqs__arrow" aria-hidden="true"></span></a></p>`
    : "") +
  `</header>`;
const guide = guideHtml.replace(
  /<h2(?:\s[^>]*)?>((?:(?!<\/h2>)[\s\S])*)<\/h2>\s*((?:<details class="bt-faq"[\s\S]*?<\/details>\s*)+)/g,
  (_m: string, h: string, items: string) => `<section class="bt-faqs" data-animate>${faqHead(h)}<div class="bt-faqs__list">${items}</div></section>`,
);
const here = Astro.url.pathname;
const crumb = nav.find((n) => n.href === here)?.label;
const others = nav.filter((n) => n.href !== here);
---
<div class="bt-page mx-auto max-w-[1120px] px-5">
  <div class="bt-page__main">
    <div class="flex flex-col gap-3 pt-6 pb-6 sm:pt-10">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-muted">
        <a href={homeHref} class="-my-1.5 inline-flex min-h-7 items-center py-1.5 text-muted no-underline hover:text-link hover:underline">{chrome.home ?? "Home"}</a>
        {crumb && (
          <>
            <Icon d={I.caretRight} size={12} class="bt-flip" />
            <span aria-current="page">{crumb}</span>
          </>
        )}
      </nav>
      <h1 class="m-0 text-[2rem] leading-[1.15] font-[650] text-ink sm:text-[2.5rem]" style="letter-spacing:var(--ls-big)">{heading}</h1>
      <p class="m-0 max-w-[56ch] text-[17px] text-muted text-pretty">{lead}</p>
      {chrome.chips && (
        <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0 pt-1">
          {chrome.chips.map((c) => (
            <li class="bt-chip"><Icon d={I.check} size={13} />{c}</li>
          ))}
        </ul>
      )}
      {sources.length === 0 && <p class="m-0 text-[13px] text-muted">{updated}</p>}
    </div>

    <div class="flex flex-col gap-5">
      <section class="bt-tool-slot">
        <slot />
      </section>

      <AdSlot unit="0000000000" />

      <article class="bt-guide pt-2">
        <Fragment set:html={guide} />
      </article>

      {sources.length > 0 && (
        <section class="bt-sources mt-4 max-w-[60ch]">
          <h2 class="m-0 text-base font-semibold">{sourcesHeading}</h2>
          {sources.map((s) => (
            <a href={s.href} rel="noopener" target="_blank">
              <Icon d={I.arrowSquareOut} size={16} class="flex-none" />
              <span>{s.label}</span>
            </a>
          ))}
          <span class="text-[13px] text-muted">{updated}</span>
        </section>
      )}
    </div>
  </div>

  {/* Sidebar on wide screens, after the content on phones: the site's other tools and one ad. */}
  <aside class="bt-page__side" aria-label={chrome.moreTools ?? "More tools"}>
    {others.length > 0 && (
      <nav class="bt-side-card" aria-label={chrome.moreTools ?? "More tools"}>
        <span class="bt-side-card__title">{chrome.moreTools ?? "More tools"}</span>
        {others.map((n) => (
          <a href={n.href}>
            <span>{n.label}</span>
            <Icon d={I.caretRight} size={14} class="bt-flip flex-none" />
          </a>
        ))}
      </nav>
    )}
    <AdSlot unit="0000000000" kind="side" />
  </aside>
</div>
