---
/**
 * Shared page shell for every Baitaan site.
 * - Theme: light/dark from the `bt_theme` cookie, else the browser setting (prefers-color-scheme).
 * - Language: each page lists its language versions; the `bt_lang` cookie (per subdomain) remembers the choice
 *   and sends returning visitors to their language (never on 404 pages, never for crawlers
 *   without cookies).
 * - Consent: Google Consent Mode v2 defaults to denied; the banner stores the choice in
 *   `bt_consent` and updates Google's tags. bt_theme and bt_consent are shared across *.baitaandessigns.com.
 */
import { SITES, type SiteKey } from "./sites";
import ConsentBanner from "./ConsentBanner.astro";
import Icon from "./Icon.astro";
import * as I from "./icons";
import type { ConsentStrings } from "./consent";

export interface PageVersion {
  /** Short code stored in the bt_lang cookie: "es", "pt", "ar", "en". */
  code: string;
  /** hreflang value, e.g. "es", "pt-BR", "ar", "en". */
  hreflang: string;
  /** Path on this site, e.g. "/en/calculadora-finiquito/". */
  href: string;
  /** Name of the language in itself: "Español", "English"… */
  label: string;
}

export interface Chrome {
  themeToggle: string;
  languageLabel: string;
  cookieSettings: string;
  consent: ConsentStrings;
  /** Breadcrumb label for the home page. */
  home?: string;
  /** Three short trust chips under tool headings ("Free", "No sign-up"…). */
  chips?: string[];
  popular?: string;
  soon?: string;
  tools?: string;
  example?: string;
  adLabel?: string;
}

/** What the layout shares with components rendered inside it (ToolPage, ToolGrid…). */
export interface ShellContext {
  chrome: Chrome;
  nav: { href: string; label: string }[];
  homeHref: string;
  dir: "ltr" | "rtl";
}

interface Props {
  site: SiteKey;
  title: string;
  description: string;
  /** Language code of this page (one of versions[].code). */
  code: string;
  lang: string;
  dir: "ltr" | "rtl";
  versions?: PageVersion[];
  nav?: { href: string; label: string }[];
  footer?: { href: string; label: string }[];
  footerNote?: string;
  brand?: string;
  homeHref?: string;
  chrome: Chrome;
  /** Off on 404 pages so a language redirect can never loop. */
  langRedirect?: boolean;
  /** The page lays out its own full-width sections (home pages, tool pages). */
  bleed?: boolean;
  /** 1120px footer instead of the 760px reading column (home pages). */
  wide?: boolean;
}

const {
  site,
  title,
  description,
  code,
  lang,
  dir,
  versions = [],
  nav = [],
  footer = [],
  footerNote = "",
  brand,
  homeHref = "/",
  chrome,
  langRedirect = true,
  bleed = false,
  wide = false,
} = Astro.props;
const s = SITES[site];
const abs = (path: string) => new URL(path, s.url).href;
const canonical = abs(Astro.url.pathname);
const others = versions.filter((v) => v.code !== code);
const xDefault = versions[0];
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT; // e.g. ca-pub-XXXXXXXXXXXXXXXX
const here = Astro.url.pathname;
(Astro.locals as { bt?: ShellContext }).bt = { chrome, nav, homeHref, dir };
const head = { code, versions: versions.map((v) => ({ code: v.code, href: v.href })), redirect: langRedirect };
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!langRedirect && <meta name="robots" content="noindex" />}
    <script is:inline define:vars={{ head }}>
      (function () {
        var doc = document.documentElement;
        function get(n) {
          var m = document.cookie.match("(?:^|; )" + n + "=([^;]*)");
          return m ? decodeURIComponent(m[1]) : null;
        }
        var shared = /(^|\.)baitaandessigns\.com$/.test(location.hostname) ? "; Domain=.baitaandessigns.com" : "";
        // Theme and consent are shared by all subdomains; `local` cookies (the language) belong to this subdomain only.
        function set(n, v, days, local) {
          var secure = location.protocol === "https:" ? "; Secure" : "";
          document.cookie = n + "=" + encodeURIComponent(v) + "; Max-Age=" + days * 86400 + "; Path=/; SameSite=Lax" + (local ? "" : shared) + secure;
        }
        // bt_lang used to be shared by all subdomains: remove that old copy so only this subdomain's choice is read.
        if (shared) document.cookie = "bt_lang=; Max-Age=0; Path=/" + shared;
        window.btCookie = { get: get, set: set };

        // Theme: saved choice, else the browser's setting.
        var saved = get("bt_theme");
        var dark = saved ? saved === "dark" : window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches;
        doc.classList.toggle("dark", !!dark);

        // Language: send visitors to the version they chose before.
        var want = get("bt_lang");
        if (head.redirect && want && want !== head.code) {
          for (var i = 0; i < head.versions.length; i++) {
            if (head.versions[i].code === want) {
              location.replace(head.versions[i].href + location.search + location.hash);
              return;
            }
          }
        }

        // Google Consent Mode v2: denied until the visitor chooses.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        var c = get("bt_consent") || "";
        var ads = /(^|\|)ads:1(\||$)/.test(c);
        var an = /(^|\|)analytics:1(\||$)/.test(c);
        var g = function (on) { return on ? "granted" : "denied"; };
        gtag("consent", "default", {
          ad_storage: g(ads),
          ad_user_data: g(ads),
          ad_personalization: g(ads),
          analytics_storage: g(an),
          wait_for_update: 500,
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {versions.length > 1 && versions.map((v) => <link rel="alternate" hreflang={v.hreflang} href={abs(v.href)} />)}
    {versions.length > 1 && <link rel="alternate" hreflang="x-default" href={abs(xDefault.href)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang.replace("-", "_")} />
    <meta name="theme-color" content="#0f766e" />
    {adClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen">
    <header class="bt-header">
      <div class="mx-auto flex max-w-[1120px] items-center gap-2 px-4 py-2">
        <a href={homeHref} class="me-auto flex min-h-11 items-center gap-2.5 font-[650] text-ink no-underline" style="letter-spacing:var(--ls)">
          <span class="bt-badge" aria-hidden="true">B</span>
          <span>{brand ?? s.name}</span>
        </a>
        {others.map((v) => (
          <a
            href={v.href}
            hreflang={v.hreflang}
            lang={v.hreflang}
            data-bt-lang={v.code}
            class="bt-lang"
            aria-label={`${chrome.languageLabel}: ${v.label}`}
          >
            <Icon d={I.globe} size={17} />
            {v.label}
          </a>
        ))}
        <button type="button" data-bt-theme class="bt-icon-btn" aria-label={chrome.themeToggle} title={chrome.themeToggle}>
          <span class="bt-theme-icon grid place-items-center">
            <Icon d={I.moon} size={20} class="dark:hidden" />
            <Icon d={I.sun} size={20} class="hidden dark:block" />
          </span>
        </button>
      </div>
      {nav.length > 0 && (
        <nav class="bt-tabs mx-auto max-w-[1120px]" aria-label={brand ?? s.name}>
          {nav.map((n) => (
            <a class="bt-tab" href={n.href} aria-current={here === n.href ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      )}
    </header>
    {bleed ? (
      <main><slot /></main>
    ) : (
      <main class="mx-auto max-w-[760px] px-5 pt-10 pb-4">
        <slot />
      </main>
    )}
    <footer class="mt-14 border-t border-hair">
      <div class:list={["mx-auto flex flex-col gap-2.5 px-5 pt-5 pb-8", wide ? "max-w-[1120px]" : "max-w-[760px]"]}>
        <nav class="flex flex-wrap gap-x-5">
          {footer.map((f) => <a class="inline-flex min-h-11 items-center text-sm text-muted no-underline hover:text-link hover:underline" href={f.href}>{f.label}</a>)}
          <button type="button" data-bt-consent-open class="inline-flex min-h-11 cursor-pointer items-center text-sm text-muted hover:text-link hover:underline">{chrome.cookieSettings}</button>
        </nav>
        <p class="m-0 text-[13px] text-muted">© {new Date().getFullYear()} MAAF Studios{footerNote && ` · ${footerNote}`}</p>
      </div>
    </footer>

    <ConsentBanner t={chrome.consent} />

    <script is:inline>
      (function () {
        var doc = document.documentElement;
        var c = window.btCookie;
        var media = window.matchMedia ? matchMedia("(prefers-color-scheme: dark)") : null;
        var meta = document.querySelector('meta[name="theme-color"]');
        function paint() {
          // Browser bar: the page background in dark mode, the brand colour in light mode.
          var v = getComputedStyle(doc).getPropertyValue(doc.classList.contains("dark") ? "--bg" : "--primary").trim();
          if (meta && v) meta.setAttribute("content", v);
        }
        paint();
        requestAnimationFrame(function () { doc.classList.add("theme-ready"); });

        // Theme toggle: saves the choice for a year.
        var btn = document.querySelector("[data-bt-theme]");
        if (btn) {
          btn.setAttribute("aria-pressed", String(doc.classList.contains("dark")));
          btn.addEventListener("click", function () {
            var dark = !doc.classList.contains("dark");
            doc.classList.toggle("dark", dark);
            btn.setAttribute("aria-pressed", String(dark));
            c.set("bt_theme", dark ? "dark" : "light", 365);
            paint();
          });
        }
        // Follow the browser while the visitor has not chosen.
        if (media && media.addEventListener) {
          media.addEventListener("change", function (e) {
            if (!c.get("bt_theme")) {
              doc.classList.toggle("dark", e.matches);
              paint();
            }
          });
        }

        // Language links remember the choice.
        document.querySelectorAll("[data-bt-lang]").forEach(function (a) {
          a.addEventListener("click", function () {
            c.set("bt_lang", a.getAttribute("data-bt-lang"), 365, true);
          });
        });
      })();
    </script>
  </body>
</html>
