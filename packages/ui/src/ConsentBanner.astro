---
/**
 * Cookie consent banner. Hidden until the script finds no `bt_consent` cookie,
 * or the visitor opens it from the footer ("Cookie settings").
 * Necessary cookies (theme, language, this choice) are always on; analytics and
 * advertising are off until the visitor allows them.
 */
import { CONSENT_DAYS, type ConsentStrings } from "./consent";

interface Props {
  t: ConsentStrings;
}
const { t } = Astro.props;
---
<section
  data-bt-consent
  hidden
  role="dialog"
  aria-labelledby="bt-consent-title"
  aria-describedby="bt-consent-text"
  class="fixed inset-x-0 bottom-0 z-50 p-3 sm:p-4"
>
  <div class="mx-auto max-w-3xl rounded-xl border border-stone-200 bg-white p-4 shadow-lg sm:p-5">
    <h2 id="bt-consent-title" class="text-base font-semibold text-stone-900">{t.title}</h2>
    <p id="bt-consent-text" class="mt-1 text-sm text-stone-600">
      {t.text} <a class="text-teal-800 underline" href={t.privacyHref}>{t.privacyLabel}</a>
    </p>

    <div data-bt-consent-details hidden class="mt-3 grid gap-2">
      <label class="flex items-start gap-3 rounded-lg border border-stone-200 p-3 text-sm">
        <input type="checkbox" checked disabled class="mt-0.5 size-4 accent-teal-700" />
        <span>
          <span class="block font-semibold text-stone-900">{t.necessary} · <span class="font-normal text-stone-500">{t.alwaysOn}</span></span>
          <span class="block text-stone-600">{t.necessaryDesc}</span>
        </span>
      </label>
      <label class="flex items-start gap-3 rounded-lg border border-stone-200 p-3 text-sm">
        <input type="checkbox" data-bt-consent-analytics class="mt-0.5 size-4 accent-teal-700" />
        <span>
          <span class="block font-semibold text-stone-900">{t.analytics}</span>
          <span class="block text-stone-600">{t.analyticsDesc}</span>
        </span>
      </label>
      <label class="flex items-start gap-3 rounded-lg border border-stone-200 p-3 text-sm">
        <input type="checkbox" data-bt-consent-ads class="mt-0.5 size-4 accent-teal-700" />
        <span>
          <span class="block font-semibold text-stone-900">{t.ads}</span>
          <span class="block text-stone-600">{t.adsDesc}</span>
        </span>
      </label>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" data-bt-consent-accept class="rounded-lg bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800">{t.accept}</button>
      <button type="button" data-bt-consent-reject class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100">{t.reject}</button>
      <button type="button" data-bt-consent-customize class="rounded-lg px-4 py-2 text-sm text-stone-700 underline hover:text-teal-800">{t.customize}</button>
      <button type="button" data-bt-consent-save hidden class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100">{t.save}</button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ days: CONSENT_DAYS }}>
  (function () {
    var c = window.btCookie;
    var box = document.querySelector("[data-bt-consent]");
    if (!box || !c) return;
    var details = box.querySelector("[data-bt-consent-details]");
    var an = box.querySelector("[data-bt-consent-analytics]");
    var ads = box.querySelector("[data-bt-consent-ads]");
    var save = box.querySelector("[data-bt-consent-save]");
    var custom = box.querySelector("[data-bt-consent-customize]");

    function current() {
      var v = c.get("bt_consent") || "";
      return { set: !!v, analytics: /(^|\|)analytics:1(\||$)/.test(v), ads: /(^|\|)ads:1(\||$)/.test(v) };
    }
    function store(a, d) {
      c.set("bt_consent", ["v1", "analytics:" + (a ? 1 : 0), "ads:" + (d ? 1 : 0), Math.floor(Date.now() / 1000)].join("|"), days);
      var g = function (on) { return on ? "granted" : "denied"; };
      if (window.gtag) {
        window.gtag("consent", "update", {
          ad_storage: g(d),
          ad_user_data: g(d),
          ad_personalization: g(d),
          analytics_storage: g(a),
        });
      }
      box.hidden = true;
      document.dispatchEvent(new CustomEvent("bt:consent", { detail: { analytics: a, ads: d } }));
    }
    function open(showDetails) {
      var s = current();
      an.checked = s.analytics;
      ads.checked = s.ads;
      details.hidden = !showDetails;
      save.hidden = !showDetails;
      custom.hidden = !!showDetails;
      box.hidden = false;
    }

    box.querySelector("[data-bt-consent-accept]").addEventListener("click", function () { store(true, true); });
    box.querySelector("[data-bt-consent-reject]").addEventListener("click", function () { store(false, false); });
    custom.addEventListener("click", function () { open(true); });
    save.addEventListener("click", function () { store(an.checked, ads.checked); });
    document.querySelectorAll("[data-bt-consent-open]").forEach(function (b) {
      b.addEventListener("click", function () { open(true); });
    });

    if (!current().set) open(false);
  })();
</script>
