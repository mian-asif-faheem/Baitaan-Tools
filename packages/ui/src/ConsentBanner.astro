---
/**
 * Cookie consent banner. Hidden until the script finds no `bt_consent` cookie,
 * or the visitor opens it from the footer ("Cookie settings").
 * Necessary cookies (theme, language, this choice) are always on; analytics and
 * advertising are off until the visitor allows them.
 */
import { CONSENT_DAYS, type ConsentStrings } from "./consent";
import Icon from "./Icon.astro";
import * as I from "./icons";

interface Props {
  t: ConsentStrings;
}
const { t } = Astro.props;
---
<section
  data-bt-consent
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="bt-consent-title"
  aria-describedby="bt-consent-text"
  class="bt-consent"
>
  <div class="flex items-center gap-2">
    <Icon d={I.cookie} size={20} />
    <h2 id="bt-consent-title" class="m-0 text-[17px] font-semibold">{t.title}</h2>
  </div>
  <p id="bt-consent-text" class="m-0 mt-2 text-sm text-muted">
    {t.text} <a class="text-ink underline underline-offset-2" href={t.privacyHref}>{t.privacyLabel}</a>
  </p>

  <div data-bt-consent-main class="mt-4 flex flex-col gap-1">
    <div class="grid grid-cols-2 gap-2">
      <button type="button" data-bt-consent-accept class="bt-btn bt-btn--sm">{t.accept}</button>
      <button type="button" data-bt-consent-reject class="bt-btn bt-btn--sm bt-btn--secondary">{t.reject}</button>
    </div>
    <button type="button" data-bt-consent-customize class="bt-link-btn self-center">{t.customize}</button>
  </div>

  <div data-bt-consent-details hidden class="mt-2">
    <div class="flex flex-col">
      <label class="bt-consent__row">
        <span><span class="block font-semibold">{t.necessary}</span><span class="block text-[13px] text-muted">{t.necessaryDesc} · {t.alwaysOn}</span></span>
        <input type="checkbox" role="switch" class="bt-switch" checked disabled />
      </label>
      <label class="bt-consent__row">
        <span><span class="block font-semibold">{t.analytics}</span><span class="block text-[13px] text-muted">{t.analyticsDesc}</span></span>
        <input type="checkbox" role="switch" class="bt-switch" data-bt-consent-analytics />
      </label>
      <label class="bt-consent__row">
        <span><span class="block font-semibold">{t.ads}</span><span class="block text-[13px] text-muted">{t.adsDesc}</span></span>
        <input type="checkbox" role="switch" class="bt-switch" data-bt-consent-ads />
      </label>
    </div>
    <div class="mt-3 flex flex-col gap-2">
      <button type="button" data-bt-consent-save class="bt-btn bt-btn--sm">{t.save}</button>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-bt-consent-accept class="bt-btn bt-btn--ghost">{t.accept}</button>
        <button type="button" data-bt-consent-reject class="bt-btn bt-btn--ghost">{t.reject}</button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ days: CONSENT_DAYS }}>
  (function () {
    var c = window.btCookie;
    var box = document.querySelector("[data-bt-consent]");
    if (!box || !c) return;
    var details = box.querySelector("[data-bt-consent-details]");
    var an = box.querySelector("[data-bt-consent-analytics]");
    var ads = box.querySelector("[data-bt-consent-ads]");
    var save = box.querySelector("[data-bt-consent-save]");
    var custom = box.querySelector("[data-bt-consent-customize]");
    var main = box.querySelector("[data-bt-consent-main]");

    function current() {
      var v = c.get("bt_consent") || "";
      return { set: !!v, analytics: /(^|\|)analytics:1(\||$)/.test(v), ads: /(^|\|)ads:1(\||$)/.test(v) };
    }
    function store(a, d) {
      c.set("bt_consent", ["v1", "analytics:" + (a ? 1 : 0), "ads:" + (d ? 1 : 0), Math.floor(Date.now() / 1000)].join("|"), days);
      var g = function (on) { return on ? "granted" : "denied"; };
      if (window.gtag) {
        window.gtag("consent", "update", {
          ad_storage: g(d),
          ad_user_data: g(d),
          ad_personalization: g(d),
          analytics_storage: g(a),
        });
      }
      box.hidden = true;
      document.dispatchEvent(new CustomEvent("bt:consent", { detail: { analytics: a, ads: d } }));
    }
    function open(showDetails) {
      var s = current();
      an.checked = s.analytics;
      ads.checked = s.ads;
      details.hidden = !showDetails;
      main.hidden = !!showDetails;
      box.hidden = false;
    }

    box.querySelectorAll("[data-bt-consent-accept]").forEach(function (b) { b.addEventListener("click", function () { store(true, true); }); });
    box.querySelectorAll("[data-bt-consent-reject]").forEach(function (b) { b.addEventListener("click", function () { store(false, false); }); });
    custom.addEventListener("click", function () { open(true); });
    save.addEventListener("click", function () { store(an.checked, ads.checked); });
    document.querySelectorAll("[data-bt-consent-open]").forEach(function (b) {
      b.addEventListener("click", function () { open(true); });
    });

    if (!current().set) open(false);
  })();
</script>
