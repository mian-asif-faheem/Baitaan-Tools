---
/**
 * One AdSense unit, set apart between guide sections (never inside a tool).
 * Renders nothing until PUBLIC_ADSENSE_CLIENT is set, so local and pre-approval builds stay ad-free.
 */
interface Props {
  slot: string;
  label?: string;
}
const { slot, label = "Publicidad" } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
{client && (
  <aside class="bt-ad" aria-label={label}>
    <span class="bt-ad__label">{label}</span>
    <ins
      class="adsbygoogle block w-full"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
