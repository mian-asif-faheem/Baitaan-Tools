---
/**
 * One AdSense unit. Renders nothing until PUBLIC_ADSENSE_CLIENT is set,
 * so local dev and pre-approval builds stay ad-free.
 * Never place a slot above or inside a tool.
 */
interface Props {
  slot: string;
  label?: string;
}
const { slot, label = "Publicidad" } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
{client && (
  <aside class="my-8" aria-label={label}>
    <ins
      class="adsbygoogle block"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
