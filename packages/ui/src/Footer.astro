---
/**
 * Site footer: a rounded card with the brand, three link columns, the legal line, and the
 * name drawn large in a pattern of dots, squares and triangles at the bottom.
 * Layout and the wordmark follow the reactbits.dev footer (FooterWaves' SVG version,
 * https://github.com/DavidHDev/react-bits, MIT + Commons Clause, see fx/LICENSE-react-bits.md).
 * The live WebGPU version is left out: the static pattern costs nothing and never moves.
 */
import { SITES, type SiteKey } from "./sites";
import Wordmark from "./Wordmark.astro";

export interface NewsletterStrings {
  placeholder: string;
  button: string;
  busy: string;
  ok: string;
  already: string;
  invalid: string;
  error: string;
}

export interface FooterStrings {
  tools: string;
  site: string;
  languages: string;
}

interface Props {
  site: SiteKey;
  brand: string;
  homeHref: string;
  note?: string;
  nav: { href: string; label: string }[];
  links: { href: string; label: string }[];
  cookieSettings: string;
  strings?: FooterStrings;
  /** Word drawn at the bottom. */
  word: string;
  /** Drawn wordmark instead of badge + typed name. */
  wordmark?: boolean;
  /** Arabic pages show the name as Arabic text instead of the Latin wordmark. */
  arabic?: boolean;
  /** Newsletter form (posts to /api/subscribe.php). */
  newsletter?: NewsletterStrings;
  lang?: string;
}

const { site, brand, homeHref, note = "", nav, links, cookieSettings, strings, word, wordmark = false, arabic = false, newsletter, lang = "en" } = Astro.props;
const s: FooterStrings = strings ?? { tools: "Tools", site: "Site", languages: "Other languages" };
const LANG_NAMES: Record<SiteKey, { label: string; lang: string }> = {
  root: { label: "baitaandessigns.com", lang: "en" },
  es: { label: "Español", lang: "es" },
  pt: { label: "Português", lang: "pt-BR" },
  ar: { label: "العربية", lang: "ar" },
};
const elsewhere = (Object.keys(SITES) as SiteKey[]).filter((k) => k !== site).map((k) => ({ href: `${SITES[k].url}/`, ...LANG_NAMES[k] }));
const year = new Date().getFullYear();

// 4×4 tile of mixed shapes, as in the original pattern.
const tile = Array.from({ length: 16 }, (_, i) => {
  const x = (i % 4) * 9 + 4.5;
  const y = Math.floor(i / 4) * 9 + 4.5;
  return { x, y, shape: (i + Math.floor(i / 4)) % 3, opacity: 0.48 + ((i * 7) % 5) * 0.11 };
});
---
<footer class="bt-foot">
  <div class="bt-foot__card">
    <div class="bt-foot__top">
      <div class="bt-foot__brand">
        <a href={homeHref} class="bt-foot__logo">
          {wordmark && arabic ? (
            <span class="bt-brand__ar text-[34px]">{brand}</span>
          ) : wordmark ? (
            <Wordmark class="h-[34px] w-auto" label={brand} />
          ) : (
            <>
              <span class="bt-badge" aria-hidden="true">B</span>
              <span>{brand}</span>
            </>
          )}
        </a>
        {note && <p>{note}</p>}
        {newsletter && (
          <form
            id="newsletter"
            class="bt-news"
            action="/api/subscribe.php"
            method="post"
            novalidate
            data-bt-news
            data-ok={newsletter.ok}
            data-already={newsletter.already}
            data-invalid={newsletter.invalid}
            data-error={newsletter.error}
            data-busy={newsletter.busy}
          >
            <label for="bt-news-email" class="sr-only">{newsletter.placeholder}</label>
            <div class="bt-news__row">
              <input
                id="bt-news-email"
                class="bt-news__input"
                type="email"
                name="email"
                required
                maxlength="254"
                autocomplete="email"
                inputmode="email"
                placeholder={newsletter.placeholder}
                aria-describedby="bt-news-msg"
              />
              <button type="submit" class="bt-btn bt-btn--sm bt-news__btn" data-magnet>{newsletter.button}</button>
            </div>
            {/* Left empty by people, filled by bots. */}
            <input class="bt-news__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="lang" value={lang} />
            {/* Empty until the visitor presses the button: then the answer appears here. */}
            <p id="bt-news-msg" class="bt-news__note" role="status" aria-live="polite"><span data-msg></span></p>
          </form>
        )}
      </div>

      <nav class="bt-foot__nav" aria-label={s.site}>
        {nav.length > 0 && (
          <div class="bt-foot__col">
            <span class="bt-foot__title">{s.tools}</span>
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
        )}
        <div class="bt-foot__col">
          <span class="bt-foot__title">{s.site}</span>
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <button type="button" data-bt-consent-open>{cookieSettings}</button>
        </div>
        <div class="bt-foot__col">
          <span class="bt-foot__title">{s.languages}</span>
          {elsewhere.map((o) => <a href={o.href} hreflang={o.lang} lang={o.lang}>{o.label}</a>)}
        </div>
      </nav>

      <div class="bt-foot__legal">
        <span>© {year} {brand}</span>
        <span>MAAF Studios</span>
      </div>
    </div>

    <div class="bt-foot__art" aria-hidden="true">
      <svg data-bt-art viewBox="0 0 800 200" focusable="false">
        <defs>
          <pattern id="bt-foot-shapes" width="36" height="36" patternUnits="userSpaceOnUse">
            <g fill="currentColor">
              {tile.map((t) =>
                t.shape === 0 ? (
                  <circle cx={t.x} cy={t.y} r="2.8" opacity={t.opacity} />
                ) : t.shape === 1 ? (
                  <rect x={t.x - 2.5} y={t.y - 2.5} width="5" height="5" opacity={t.opacity} />
                ) : (
                  <path d={`M${t.x} ${t.y - 3}l3 5.5h-6z`} opacity={t.opacity} />
                ),
              )}
            </g>
          </pattern>
          <mask id="bt-foot-mask">
            <rect x="-5000" y="-5000" width="10000" height="10000" fill="white" />
            <text x="40" y="236" direction="ltr" fill="black" font-weight="600" font-size="200">{word}</text>
          </mask>
        </defs>
        <rect x="-5000" y="-5000" width="10000" height="10000" fill="url(#bt-foot-shapes)" mask="url(#bt-foot-mask)" />
      </svg>
    </div>
  </div>
</footer>

<script>
  // Fit the word to the card: measure its ink, then size the viewBox so the letters fill the
  // width and only their top 78% shows, with room above for the pattern to fade in.
  const fit = () => {
    const svg = document.querySelector<SVGSVGElement>("[data-bt-art]");
    const text = svg?.querySelector("text");
    const pattern = svg?.querySelector("pattern");
    if (!svg || !text || !pattern) return;
    const family = getComputedStyle(svg).fontFamily;
    const ctx = document.createElement("canvas").getContext("2d");
    if (!ctx) return;
    ctx.font = `600 200px ${family}`;
    const m = ctx.measureText(text.textContent ?? "");
    const ink = m.actualBoundingBoxLeft + m.actualBoundingBoxRight;
    const glyph = m.actualBoundingBoxAscent + m.actualBoundingBoxDescent;
    if (!(ink > 0 && glyph > 0)) return;
    const pad = ink * 0.035;
    const above = glyph * 0.46;
    // Latin letters show their top 78%; Arabic sits on the baseline, so it shows in full.
    const shown = /[\u0600-\u06ff]/.test(text.textContent ?? "") ? 1 : 0.78;
    const h = above + glyph * shown;
    // A short word would grow very tall: keep the art at least 4.5:1 and centre the word.
    const w = Math.max(ink + pad * 2, h * 4.5);
    const x0 = (w - ink) / 2;
    svg.setAttribute("viewBox", `0 0 ${w.toFixed(1)} ${h.toFixed(1)}`);
    text.setAttribute("font-family", family);
    text.setAttribute("x", (x0 + m.actualBoundingBoxLeft).toFixed(1));
    text.setAttribute("y", (above + m.actualBoundingBoxAscent).toFixed(1));
    // About 135 cells across, like the original (9px cells on a 1215px card).
    pattern.setAttribute("patternTransform", `scale(${(w / 135 / 9).toFixed(4)})`);
    svg.parentElement?.style.setProperty("--art-fade", `${(((above + glyph * (shown - 0.2)) / h) * 100).toFixed(1)}%`);
  };
  fit();
  document.fonts?.ready.then(fit);

  // Entrance, every time the footer scrolls into view: the card's background fades in, then each
  // piece of text rises from below with a fade (logo, tagline, newsletter, each column, the legal
  // line), then the big word rises from the card's bottom edge. When the footer goes back below the
  // screen it resets, so scrolling down to it again plays it again. Off under "reduce motion".
  const enter = () => {
    const card = document.querySelector<HTMLElement>(".bt-foot__card");
    if (!card || matchMedia("(prefers-reduced-motion: reduce)").matches || typeof IntersectionObserver !== "function") return;
    const ease = "cubic-bezier(0.215, 0.61, 0.355, 1)";
    const items = [
      card.querySelector(".bt-foot__logo"),
      card.querySelector(".bt-foot__brand > p"),
      card.querySelector(".bt-news"),
      ...card.querySelectorAll(".bt-foot__col"),
      card.querySelector(".bt-foot__legal"),
    ].filter(Boolean) as HTMLElement[];
    const art = card.querySelector<HTMLElement>(".bt-foot__art svg");
    const all = [card, ...items, ...(art ? [art] : [])];
    let runs: Animation[] = [];
    let shown = false;

    const hide = () => {
      runs.forEach((r) => r.cancel());
      runs = [];
      all.forEach((el) => (el.style.opacity = "0"));
      shown = false;
    };
    const play = (el: HTMLElement, frames: Keyframe[], delay: number, duration: number) => {
      const run = el.animate(frames, { duration, delay, easing: ease, fill: "both" });
      runs.push(run);
      run.onfinish = () => {
        el.style.opacity = "";
        run.cancel();
      };
    };
    const show = () => {
      if (shown) return;
      shown = true;
      // 1. The card's background.
      play(card, [{ opacity: 0, transform: "translateY(24px)" }, { opacity: 1, transform: "none" }], 0, 500);
      // 2. The text, from below, one piece after another.
      items.forEach((el, i) =>
        play(el, [{ opacity: 0, transform: "translateY(32px)" }, { opacity: 1, transform: "none" }], 250 + i * 70, 650),
      );
      // 3. The big word rises from the bottom edge (the card clips it).
      if (art) play(art, [{ opacity: 0, transform: "translateY(70%)" }, { opacity: 1, transform: "none" }], 250 + items.length * 70, 900);
    };

    hide();
    new IntersectionObserver(
      (seen) => {
        const e = seen[seen.length - 1];
        if (e.isIntersecting) show();
        // Back below the screen: reset, so it plays again next time.
        else if (e.boundingClientRect.top > 0) hide();
      },
      { threshold: 0.12 },
    ).observe(card);
  };
  enter();

  // Newsletter: send without leaving the page and show the answer under the field.
  const news = document.querySelector<HTMLFormElement>("[data-bt-news]");
  if (news) {
    const msg = news.querySelector<HTMLElement>("[data-msg]");
    const btn = news.querySelector<HTMLButtonElement>("button[type=submit]");
    const input = news.querySelector<HTMLInputElement>("input[type=email]");
    const show = (status: string) => {
      const text = news.dataset[status] ?? news.dataset.error;
      if (msg && text) msg.textContent = text;
      news.dataset.state = status;
    };
    // Coming back from the no-JavaScript fallback: ?newsletter=ok
    const back = new URLSearchParams(location.search).get("newsletter");
    if (back && ["ok", "already", "invalid", "error"].includes(back)) show(back);
    news.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input?.checkValidity()) {
        show("invalid");
        input?.focus();
        return;
      }
      const label = btn?.textContent ?? "";
      if (btn) {
        btn.disabled = true;
        btn.textContent = news.dataset.busy ?? label;
      }
      try {
        const res = await fetch(news.action, { method: "POST", body: new FormData(news), headers: { Accept: "application/json" } });
        const data = await res.json().catch(() => ({ status: "error" }));
        show(typeof data.status === "string" ? data.status : "error");
        if (data.status === "ok" || data.status === "already") news.reset();
      } catch {
        show("error");
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = label;
        }
      }
    });
  }
</script>
