---
/**
 * Home-page hero: a big heading that sharpens in word by word (the page's one authored moment),
 * the lead, the trust promise as plain chips, and an optional call to action, on a quietly
 * tinted band. The text is readable from the first frame.
 */
import Icon from "./Icon.astro";
import * as I from "./icons";
import { shell } from "./shell";

interface Props {
  title: string;
  lead: string;
  cta?: { href: string; label: string };
}
const { title, lead, cta } = Astro.props;
const { chrome } = shell(Astro.locals);
const words = title.split(" ");
---
<section class="bt-hero">
  <div class="mx-auto flex max-w-[1120px] flex-col items-start gap-4 px-5 pt-[clamp(24px,4vw,40px)] pb-[clamp(32px,4vw,48px)]">
    <h1 class="m-0 max-w-[13ch] text-[clamp(38px,10vw,72px)] leading-[1.08] font-[650] text-ink" style="letter-spacing:var(--ls-big)">
      {words.map((w, i) => (
        <>
          <span class="bt-word" style={`animation-delay:${Math.min(i, 10) * 50}ms`}>{w}</span>{i < words.length - 1 && " "}
        </>
      ))}
    </h1>
    <p class="m-0 max-w-[52ch] text-[clamp(17px,2vw,20px)] text-muted text-pretty">{lead}</p>
    {chrome.chips && (
      <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
        {chrome.chips.map((c) => (
          <li class="bt-chip"><Icon d={I.check} size={13} />{c}</li>
        ))}
      </ul>
    )}
    {cta && (
      <a href={cta.href} class="bt-btn bt-btn--sm mt-1">
        {cta.label}
        <Icon d={I.arrowRight} size={18} class="bt-flip" />
      </a>
    )}
  </div>
</section>
